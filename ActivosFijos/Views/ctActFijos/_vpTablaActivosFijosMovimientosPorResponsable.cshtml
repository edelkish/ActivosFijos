@model IEnumerable<ActivosFijos.Models.AuxBD.ActivosFijosMovimientosResponsables>

<table class="table table-striped table-bordered table-hover" id="tablaMovimientosActivosFijos">
    <thead style="background-color: #444d58 !important; color: #ced5de">
        <tr>                   
            <th scope="col" style="text-align:justify;min-width:270px">
                Responsable
            </th>
            <th scope="col" style="text-align:justify;min-width:270px">
                &Aacute;rea
            </th>
            <th scope="col" style="text-align:center;min-width:100px" width="7%">
                Fecha
            </th>
            <th scope="col" style="text-align:center;min-width:100px" width="7%">

            </th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            string area = item.areaResponsabilidad.ToString();
            string responsable = item.responsable.ToString();
            string fecha = item.fechaSubmayor.ToString("yyyy-MM-dd");
            <tr data-area="@item.areaResponsabilidad" data-responsable="@item.responsable" data-fecha="@item.fechaSubmayor.ToString("yyyy-MM-dd")">
                <td style="text-align:justify">
                    @Html.DisplayFor(modelItem => item.nombreResponsable)
                </td>
                <td style="text-align:justify">
                    @Html.DisplayFor(modelItem => item.nombreAreaResponsabilidad)
                </td>
                <td style="text-align:center">
                    @item.fechaSubmayor.ToString("MM/yyyy")
                </td>
                <td style="text-align:justify">
                    <a href="javascript:;" onclick="VerDetalles('@area', '@responsable', '@fecha')" class="btn yellow btn-outline sbold uppercase"><i class="fa fa-eye"></i>&nbsp; Ver Detalles</a>
                </td>
            </tr>
        }
    </tbody>
</table>
