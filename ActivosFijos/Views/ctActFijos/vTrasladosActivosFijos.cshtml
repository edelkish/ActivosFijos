@using ActivosFijos.Clases
@using ActivosFijos.Models.Auxiliar

@model List<mdMovimientosAFT>

@{
    ViewData["Title"] = "Traslados de Activos Fijos";
    Layout = "~/Views/Shared/_Layout.cshtml";

    clResponse<ActivosFijos.Models.Auxiliar.mdMovimientosAFT> respuesta = new clResponse<ActivosFijos.Models.Auxiliar.mdMovimientosAFT>();
    if (ViewBag.respuesta != null)
    {
        respuesta = ViewBag.respuesta;
    }
}

@section PluginsCSS{
    <environment names="Development,Staging,Production">
        <link href="~/global/plugins/datatables/datatables.min.css" rel="stylesheet" type="text/css">
        <link href="~/global/plugins/datatables/plugins/bootstrap/datatables.bootstrap.css" rel="stylesheet" type="text/css">
        <link rel="stylesheet" href="~/global/plugins/jquery-confirm/css/jquery-confirm.css">
    </environment>
}
@section Styles{
    <style type="text/css">
        .mt-checkbox-list, .mt-radio-list {
            padding: 0 0;
        }
    </style>
}
@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery Xsrf
@functions
{
    public string GetAntiXsrfRequestToken() => Xsrf.GetAndStoreTokens(Context).RequestToken;
}
<div class="page-head">
    <div class="container-fluid">
        <!-- BEGIN PAGE TITLE -->
        <div class="page-title">
            <h1>
                Activos Fijos | Historial de Movimientos
            </h1>
        </div>
        <!-- END PAGE TITLE -->
    </div>
</div>
<!-- BEGIN PAGE CONTENT BODY -->
<div class="page-content">
    <div class="container-fluid">
        <!-- BEGIN PAGE BREADCRUMBS -->
        <ul class="page-breadcrumb breadcrumb">
            <li>
                <a asp-action="Inicio" asp-controller="ctInicio">Inicio</a>
                <i class="fa fa-circle"></i>
            </li>
            <li>
                <span>Activos Fijos</span>
                <i class="fa fa-circle"></i>
            </li>
            <li>
                <a asp-action="Traslados" asp-controller="ctActFijos">Traslados</a>
                <i class="fa fa-circle"></i>
            </li>
            <li>
                <span>Tabla con los traslados de movimientos</span>
            </li>
        </ul>
        <!-- END PAGE BREADCRUMBS -->
        <div class="page-content-inner util-btn-margin-bottom-5">
            <div class="row">
                <div class="col-md-6">
                    <div class="portlet box blue-hoki">
                        <div class="portlet-title">
                            <div class="caption">
                                Listado de Activos Fijos
                            </div>
                            <div class="tools">
                            </div>
                        </div>
                        <div class="portlet-body">
                            <table class="table table-striped table-bordered table-hover" id="tablaActivosFijos">
                                <thead style="background-color: #444d58 !important; color: #ced5de">
                                    <tr>
                                        <th scope="col" style="text-align:justify;min-width:70px;" width="7%">
                                            No. Inventario
                                        </th>
                                        <th scope="col" style="text-align:justify;min-width:200px" width="225px">
                                            Descripci&oacute;n
                                        </th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in Model)
                                    {
                                        <tr data-info="@item.noInventario">
                                            <td style="text-align:justify">
                                                @Html.DisplayFor(modelItem => item.noInventario)
                                            </td>
                                            <td style="text-align:justify">
                                                @Html.DisplayFor(modelItem => item.descripcion)
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>

                        </div>
                    </div>
                </div>
                <div class="col-md-6" id="cargar">
                    <!-- BEGIN Portlet PORTLET-->
                    <div class="portlet box blue-hoki">
                        <div class="portlet-title">
                            <div class="caption">
                                Traslados de AFT
                            </div>
                            <div class="tools">
                                <a href="" class="fullscreen"> </a>
                            </div>
                        </div>
                        <div class="portlet-body">
                            <input type="hidden" id="RequestVerificationToken" name="RequestVerificationToken"
                                   value="@GetAntiXsrfRequestToken()">
                            <div id="gridTrasladosActivosFijos">
                                <table class="table table-striped table-bordered table-hover" id="tablaTrasladosActivosFijos">
                                    <thead style="background-color: #444d58 !important; color: #ced5de">
                                        <tr>
                                            <th scope="col" style="text-align:justify;min-width:120px" width="120px">
                                                No. Inv.
                                            </th>
                                            <th scope="col" style="text-align:justify;min-width:300px" width="315px">
                                                Descrpci&oacute;n
                                            </th>
                                            <th scope="col" style="text-align:justify;min-width:270px" width="275px">
                                                Responsable
                                            </th>
                                            <th scope="col" style="text-align:justify;min-width:270px" width="275px">
                                                &Aacute;rea
                                            </th>
                                            <th scope="col" style="text-align:justify;min-width:200px" width="225px">
                                                Fecha Salida
                                            </th>
                                            <th scope="col" style="text-align:justify;min-width:200px" width="225px">
                                                Fecha Entrada
                                            </th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <tr>
                                            <td style="text-align:justify">
                                                <b></b>
                                            </td>
                                            <td style="text-align:justify">
                                                <b></b>
                                            </td>
                                            <td style="text-align:justify">
                                                <b></b>
                                            </td>
                                            <td style="text-align:justify">
                                                <b></b>
                                            </td>
                                            <td style="text-align:justify">
                                                <b></b>
                                            </td>
                                            <td style="text-align:justify">
                                                <b></b>
                                            </td>
                                        </tr>
                                    </tbody>
                                </table>

                            </div>
                        </div>
                    </div>
                    <!-- END Portlet PORTLET-->
                </div>
            </div>
        </div>
        <!-- END PAGE CONTENT INNER -->
    </div>
</div>
<!-- END PAGE CONTENT BODY -->
@section PluginsJS {
    <environment names="Development,Staging,Production">
        <script src="~/global/scripts/datatable.js" type="text/javascript"></script>
        <script src="~/global/plugins/datatables/datatables.min.js" type="text/javascript"></script>
        <script src="~/global/plugins/datatables/plugins/bootstrap/datatables.bootstrap.js" type="text/javascript"></script>

        <script src="~/global/plugins/notifications/noty.min.js"></script>
        <script src="~/global/plugins/jquery-confirm/js/jquery-confirm.js"></script>
    </environment>
}

@section Scripts {
    <script src="~/global/paginas/cargandoFiles.js" type="text/javascript"></script>

    <script type="text/javascript">
        var baseUrl = $('base').attr('href'), idFilaSeleccionada = -1, idFilaSeleccionadaAux = "";

        var siSatisfactorio = '@respuesta.SiSatisfactorio';
        var mensaje = '@respuesta.Mensaje';

        if ((siSatisfactorio == "True") && (mensaje != "")) {
            MiApp.Mensajes.mostrarNotificacion("success", mensaje);
        }
        else if ((siSatisfactorio == "False") && (mensaje != "")) {
            MiApp.Mensajes.mostrarNotificacion("error", mensaje);
        }

        CargarActivosFijos();

        function CargarActivosFijos() {
            var TableDatatablesButtons = function () {
                var e = function () {
                    var e = $("#tablaActivosFijos");
                    e.dataTable({
                        language: {
                            url: baseUrl + "global/language/Spanish.json",
                            aria: {
                                sortAscending: ": activate to sort column ascending",
                                sortDescending: ": activate to sort column descending"
                            },
                            emptyTable: "No data available in table",
                            info: "Showing _START_ to _END_ of _TOTAL_ entries",
                            infoEmpty: "No entries found",
                            infoFiltered: "(filtered1 from _MAX_ total entries)",
                            lengthMenu: "_MENU_ entries",
                            search: "Search:",
                            zeroRecords: "No matching records found"
                        },
                        "autoWidth": false,
                        buttons: [],
                        order: [],
                        lengthMenu: [[10, 15, 20, -1], [10, 15, 20, "All"]],
                        pageLength: 20,
                        pagingType: "bootstrap_full_number",
                        dom: "<'row' <'col-md-12'B>><'row'<'col-md-6 col-sm-12'l><'col-md-6 col-sm-12'f>r><'table-scrollable't><'row'<'col-md-5 col-sm-12'i><'col-md-7 col-sm-12'p>>"
                    });

                    $('#tablaActivosFijos').on('click', 'tr', function () {
                        if ($(this).hasClass('selected')) {
                            $(this).removeClass('selected');
                            idFilaSeleccionada = null;
                            //document.getElementById('editar').setAttribute('disabled', true);
                        }
                        else {
                            e.$('tr.selected').removeClass('selected');
                            $(this).addClass('selected');
                            idFilaSeleccionada = $(this).data('info');
                            CargarMovimientos(idFilaSeleccionada);
                            //document.getElementById('editar').removeAttribute('disabled');
                        }
                    });
                }

                return {
                    init: function () {
                        jQuery().dataTable && (e())
                    }
                }
            }();

            TableDatatablesButtons.init();
        }

        function CargarTraslados() {
            mostrarLoadingPanel("cargar", "Cargando datos");
            $.ajax({
                url: baseUrl + 'ctActFijos/ListadoDeTrasladosDeAFT',
                method: 'POST',
                data: { },
                beforeSend: function (xhr) {
                    xhr.setRequestHeader("XSRF-TOKEN", $('#RequestVerificationToken').val());
                },
                success: function (data) {
                    $('#gridTrasladosActivosFijos').html(data);

                    var TableDatatablesButtons = function () {
                        var e = function () {
                            var e = $("#tablaTrasladosActivosFijos");
                            e.dataTable({
                                language: {
                                    url: baseUrl + "global/language/Spanish.json",
                                    aria: {
                                        sortAscending: ": activate to sort column ascending",
                                        sortDescending: ": activate to sort column descending"
                                    },
                                    emptyTable: "No data available in table",
                                    info: "Showing _START_ to _END_ of _TOTAL_ entries",
                                    infoEmpty: "No entries found",
                                    infoFiltered: "(filtered1 from _MAX_ total entries)",
                                    lengthMenu: "_MENU_ entries",
                                    search: "Search:",
                                    zeroRecords: "No matching records found"
                                },
                                "autoWidth": false,
                                buttons: [],
                                order: [],
                                lengthMenu: [[10, 15, 20, -1], [10, 15, 20, "All"]],
                                pageLength: 20,
                                pagingType: "bootstrap_full_number",
                                dom: "<'row' <'col-md-12'B>><'row'<'col-md-6 col-sm-12'l><'col-md-6 col-sm-12'f>r><'table-scrollable't><'row'<'col-md-5 col-sm-12'i><'col-md-7 col-sm-12'p>>"
                            });

                            $('#tablaTrasladosActivosFijos').on('click', 'tr', function () {
                                if ($(this).hasClass('selected')) {
                                    $(this).removeClass('selected');
                                    idFilaSeleccionada = null;
                                    idFilaSeleccionadaAux = "";
                                    //document.getElementById('editar').setAttribute('disabled', true);
                                }
                                else {
                                    e.$('tr.selected').removeClass('selected');
                                    $(this).addClass('selected');
                                    idFilaSeleccionada = $(this).data('info');
                                    idFilaSeleccionadaAux = $(this).data('fecha');
                                    //document.getElementById('editar').removeAttribute('disabled');
                                }
                            });
                        }

                        return {
                            init: function () {
                                jQuery().dataTable && (e())
                            }
                        }
                    }();

                    TableDatatablesButtons.init();
                },
                error: function (error) {
                    console.log(error);
                },
                complete: function () {
                    ocultarLoadingPanel("cargar");
                }
            });
        }

    </script>
}



