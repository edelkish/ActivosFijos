@section PluginsJS {
    <environment names="Development,Staging,Production">
        <script src="~/global/scripts/datatable.js" type="text/javascript"></script>
        <script src="~/global/plugins/datatables/datatables.min.js" type="text/javascript"></script>
        <script src="~/global/plugins/datatables/plugins/bootstrap/datatables.bootstrap.js" type="text/javascript"></script>

        <script src="~/global/plugins/notifications/noty.min.js"></script>
        <script src="~/global/plugins/jquery-confirm/js/jquery-confirm.js"></script>

        <script type="text/javascript" src="~/global/plugins/moment/min/moment.min.js"></script>
        <script type="text/javascript" src="~/global/plugins/moment/locale/es.js"></script>
        <script src="~/global/plugins/eonasdan-bootstrap-datetimepicker/build/js/bootstrap-datetimepicker.min.js" type="text/javascript"></script>

        <script src="~/global/plugins/select2/js/select2.full.min.js" type="text/javascript"></script>
    </environment>
}

@section Scripts {
    <script src="~/global/paginas/cargandoFiles.js" type="text/javascript"></script>

    <script type="text/javascript">
        var baseUrl = $('base').attr('href'), idFilaSeleccionada = -1, idFilaSeleccionadaAux = "";

        var siSatisfactorio = '@respuesta.SiSatisfactorio';
        var mensaje = '@respuesta.Mensaje';

        if ((siSatisfactorio == "True") && (mensaje != "")) {
            MiApp.Mensajes.mostrarNotificacion("success", mensaje);
        }
        else if ((siSatisfactorio == "False") && (mensaje != "")) {
            MiApp.Mensajes.mostrarNotificacion("error", mensaje);
        }

        var f = new Date('@fch'), anno = @fch.Split('-')[0], mes = @fch.Split('-')[1], dia = @fch.Split('-')[2];

        var fecha = moment(new Date(anno, mes - 1, dia)).format("MM/YYYY");
        document.getElementById('Fecha').value = fecha;

        var subMayor;

    </script>

    <script src="~/global/paginas/tablaActivosFijosImportados.js" type="text/javascript"></script>

    <script type="text/javascript">

        InicializarSelect2("#Area", "Seleccione el área");
        InicializarSelect2("#Responsable", "Seleccione el responsable");

        $('#datetimepickerImportar').datetimepicker({
            format: 'MM/YYYY',
            locale: 'es',
            viewMode: 'months'
        }).on('dp.change', function (event) {
            var valueFecha = moment(new Date(event.date._d)).format("MM/YYYY");
            CargarAreasPorFecha(valueFecha);
            CargarResponsablesPorFecha(valueFecha);
        });

        $('#refrescar').on('click', function () {
            var valueFecha = $('#fGeneracion').val();
            CargarTablaActivosFijosImportados(valueFecha);
        });

        $('#mostrar').on('click', function () {
            var valueFecha = $('#Fecha').val();
            CargarTablaActivosFijosImportados(valueFecha);
        });

        $('#exportarCompleto').on('click', function () {
            var valueFecha = $('#Fecha').val();
            var valueArea = $('#Area').val();
            var valueResponsable = $('#Responsable').val();
            $('#exportFecha').val(valueFecha);
            $('#exportArea').val(valueArea);
            $('#exportResponsable').val(valueResponsable);
            $('#formExportarCompleto').submit();
        });

        $('#crear').on('click', function () {
            var link = '@Html.Raw(Url.Action("CrearActivoFijo", "ctActFijos"))';
            window.location.href = link;
        });

        $('#editar').on('click', function () {
            var link = '@Url.Action("EditarActivoFijo", "ctActFijos", new { id = "idActivoFijo", fecha = "vFecha" })'; //, subMayor = "vSubMayor" }))';
            link = link.replace("idActivoFijo", idFilaSeleccionada).replace("vFecha", idFilaSeleccionadaAux);
            //var _link = link.replace("subMayor=vSubMayor", sub);
            window.location.href = link;
        });

        $('#eliminar').on('click', function () {
            if (idFilaSeleccionada != null) {
                $.confirm({
                    title: '!Advertencia de eliminación!',
                    content: '¿Está seguro de que desea eliminar la fila seleccionada?',
                    icon: 'fa fa-warning',
                    type: 'red',
                    theme: 'light',
                    animation: 'news',
                    closeAnimation: 'news',
                    buttons: {
                        tryAgain: {
                            text: 'Eliminar',
                            btnClass: 'btn-red',
                            action: function () {
                                $.ajax({
                                    url: baseUrl + 'ctActFijos/EliminarActivosFijos',
                                    method: "POST",
                                    data: { id: idFilaSeleccionada },
                                    beforeSend: function (xhr) {
                                        xhr.setRequestHeader("XSRF-TOKEN", $('#RequestVerificationToken').val());
                                    },
                                    success: function (data) {
                                        if (data.siNo) {
                                            MiApp.Mensajes.mostrarNotificacion("success", data.objMensaje);
                                            CargarTablaActivosFijos();
                                        } else {
                                            MiApp.Mensajes.mostrarNotificacion("error", data.objMensaje);
                                        }
                                    },
                                    error: function (error) {
                                        MiApp.Mensajes.mostrarNotificacion("error", error);
                                    }
                                });
                            }
                        },
                        cancelar: function () {

                        }
                    }
                });
            } else {
                $.confirm({
                    title: '!Operación incorrecta!',
                    content: 'Debe seleccionar una fila para que la operación sea válida.',
                    icon: 'fa fa-warning',
                    type: 'red',
                    theme: 'supervan', //light
                    animation: 'news',
                    closeAnimation: 'news',
                    buttons: {
                        omg: {
                            text: 'Intentar nuevamente',
                            btnClass: 'btn-red',
                        }
                    }
                });
            }
        });

        $('#Area').on('change', function () {
            var areaResponsabilidad = $('#Area').val();

            $.ajax({
                url: baseUrl + 'ctActFijos/CargarDatosResponsablesPorAreaYFecha',
                method: 'POST',
                async: false,
                data: { area: areaResponsabilidad, fecha: $('#Fecha').val() },
                beforeSend: function (xhr) {
                    xhr.setRequestHeader("XSRF-TOKEN", $('#RequestVerificationToken').val());
                },
                success: function (data) {
                    $('#selectResponsables').html(data);

                    InicializarSelect2("#Responsable", "Seleccione el responsable");
                },
                error: function (err) {
                    console.log(err);
                }

            });
        });

        function InicializarSelect2(idSelect2, placeHolder) {
            $.fn.select2.defaults.set("theme", "bootstrap");
            $(idSelect2).select2({
                //allowClear: !0,
                placeholder: placeHolder,
                width: null
            });
        }

        function CargarAreasPorFecha(valueFecha) {
            $.ajax({
                url: baseUrl + 'ctActFijos/ListadoDeAreasAFTPorFecha',
                method: 'POST',
                async: false,
                data: { fecha: valueFecha },
                beforeSend: function (xhr) {
                    xhr.setRequestHeader("XSRF-TOKEN", $('#RequestVerificationToken').val());
                },
                success: function (data) {
                    $('#selectAreas').html(data);

                    InicializarSelect2("#Area", "Seleccione el área");

                    $('#Area').on('change', function () {
                        var areaResponsabilidad = $('#Area').val();

                        $.ajax({
                            url: baseUrl + 'ctActFijos/CargarDatosResponsablesPorAreaYFecha',
                            method: 'POST',
                            async: false,
                            data: { area: areaResponsabilidad, fecha: $('#Fecha').val() },
                            beforeSend: function (xhr) {
                                xhr.setRequestHeader("XSRF-TOKEN", $('#RequestVerificationToken').val());
                            },
                            success: function (data) {
                                $('#selectResponsables').html(data);

                                InicializarSelect2("#Responsable", "Seleccione el responsable");
                            },
                            error: function (err) {
                                console.log(err);
                            }

                        });
                    });
                },
                error: function (err) {
                    console.log(err);
                }

            });
        }

        function CargarResponsablesPorFecha(valueFecha) {
            $.ajax({
                url: baseUrl + 'ctActFijos/ListadoDeResponsablesAFTPorFecha',
                method: 'POST',
                async: false,
                data: { fecha: valueFecha },
                beforeSend: function (xhr) {
                    xhr.setRequestHeader("XSRF-TOKEN", $('#RequestVerificationToken').val());
                },
                success: function (data) {
                    $('#selectResponsables').html(data);

                    InicializarSelect2("#Responsable", "Seleccione el responsable");
                },
                error: function (err) {
                    console.log(err);
                }

            });
        }
    </script>
}