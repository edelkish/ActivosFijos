@using ActivosFijos.Clases
@{
    ViewData["Title"] = "Listado de activos fijos importados";
    Layout = "~/Views/Shared/_Layout.cshtml";

    clResponse<ActivosFijos.Models.Auxiliar.mdSubmayorErrores> respuesta = new clResponse<ActivosFijos.Models.Auxiliar.mdSubmayorErrores>();
    if (ViewBag.respuesta != null)
    {
        respuesta = ViewBag.respuesta;
    }

    string fch = Model.Fecha.ToString("yyyy-MM-dd");
}

@model ActivosFijos.Models.Auxiliar.mdSubmayorErrores

@section PluginsCSS{
