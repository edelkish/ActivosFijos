                                    @*<button type="button" id="eliminar" class="btn grey-mint btn-outline sbold uppercase" disabled><i class="fa fa-trash"></i> Eliminar</button>*@
                                    <button type="button" id="refrescar" class="btn grey-mint btn-outline sbold uppercase"><i class="fa fa-refresh"></i> Refrescar</button>
                                    <form id="formExportarCompleto" asp-action="ExportarListadoCompletoAFT" asp-controller="ctActFijos" method="post" style="display:inline">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="fecha" id="exportFecha" />
                                        <input type="hidden" name="area" id="exportArea" />
                                        <input type="hidden" name="responsable" id="exportResponsable" />
                                        <button type="button" id="exportarCompleto" class="btn blue-hoki btn-outline sbold uppercase"><i class="fa fa-file-excel-o"></i> Exportar Excel</button>
                                    </form>
                                </p>
                            </div>
                            <input type="hidden" id="RequestVerificationToken" name="RequestVerificationToken"
                                   value="@GetAntiXsrfRequestToken()">
                            <div id="gridActivosFijos">
