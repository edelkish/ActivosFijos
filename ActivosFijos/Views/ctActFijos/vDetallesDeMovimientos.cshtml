@using ActivosFijos.Clases
@using Microsoft.AspNetCore.Mvc.Rendering
@{
    ViewData["Title"] = "Detalles de los Movimientos";
    Layout = "~/Views/Shared/_Layout.cshtml";

    clResponse<ActivosFijos.Models.Auxiliar.mdActas> respuesta = new clResponse<ActivosFijos.Models.Auxiliar.mdActas>();
    if (ViewBag.respuesta != null)
    {
        respuesta = ViewBag.respuesta;
    }

    string fch = Model.Fecha.ToString("yyyy-MM-dd");
}

@model ActivosFijos.Models.Auxiliar.mdActas

@section PluginsCSS{
    <environment names="Development,Staging,Production">
        <link href="~/global/plugins/datatables/datatables.min.css" rel="stylesheet" type="text/css">
        <link href="~/global/plugins/datatables/plugins/bootstrap/datatables.bootstrap.css" rel="stylesheet" type="text/css">
        <link rel="stylesheet" href="~/global/plugins/jquery-confirm/css/jquery-confirm.css">

        <link href="~/global/plugins/eonasdan-bootstrap-datetimepicker/build/css/bootstrap-datetimepicker.min.css" rel="stylesheet" type="text/css" />

        <link href="~/global/plugins/select2/css/select2.min.css" rel="stylesheet" type="text/css" />
        <link href="~/global/plugins/select2/css/select2-bootstrap.min.css" rel="stylesheet" type="text/css" />
    </environment>
}
@section Styles{
    <style type="text/css">
        .mt-checkbox-list, .mt-radio-list {
            padding: 0 0;
        }
    </style>
}
@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery Xsrf
@functions
{
    public string GetAntiXsrfRequestToken() => Xsrf.GetAndStoreTokens(Context).RequestToken;
}
<div class="page-head">
    <div class="container-fluid">
        <!-- BEGIN PAGE TITLE -->
        <div class="page-title">
            <h1>
                Activos Fijos | Movimientos
            </h1>
        </div>
        <!-- END PAGE TITLE -->
    </div>
</div>
<!-- BEGIN PAGE CONTENT BODY -->
<div class="page-content">
    <div class="container-fluid">
        <!-- BEGIN PAGE BREADCRUMBS -->
        <ul class="page-breadcrumb breadcrumb">
            <li>
                <a asp-action="Inicio" asp-controller="ctInicio">Inicio</a>
                <i class="fa fa-circle"></i>
            </li>
            <li>
                <span>Activos Fijos</span>
                <i class="fa fa-circle"></i>
            </li>
            <li>
                <a asp-action="DetallesDeMovimientos" asp-controller="ctActFijos">Movimientos</a>
                <i class="fa fa-circle"></i>
            </li>
            <li>
                <span>Tabla con los detalles de los movimientos</span>
            </li>
        </ul>
        <!-- END PAGE BREADCRUMBS -->
        <div class="page-content-inner util-btn-margin-bottom-5">
            <div class="row">
                <div class="col-md-3">
                    <div class="portlet box blue-hoki">
                        <div class="portlet-title">
                            <div class="caption">
                                Datos del Movimiento
                            </div>
                            <div class="tools">
                            </div>
                        </div>
                        <div class="portlet-body form">
                            <form asp-action="GenerarActaAFT" asp-controller="ctActFijos" method="post">
                                <div class="form-body">
                                    @Html.AntiForgeryToken()
                                    <div class="form-group">
                                        <label class="control-label">Mes y A&ntilde;o:</label>
                                        <div class='input-group date' id='datetimepickerImportar'>
                                            <input type='text' class="form-control" asp-for="Fecha" />
                                            <span class="input-group-addon">
                                                <span class="glyphicon glyphicon-calendar"></span>
                                            </span>
                                        </div>
                                    </div>
                                    <div id="selectAreas">
                                        <partial name="_vpAreas" model="Model" />
                                    </div>
                                    <div id="selectResponsables">
                                        <partial name="_vpResponsables" model="Model" />
                                    </div>
                                </div>
                                <div class="form-actions">
                                    <div class="btn-set pull-left">
                                        <button type="submit" class="btn blue-hoki btn-outline sbold uppercase" id="generarActa"><i class="fa fa-file"></i> Generar Acta</button>
                                        <button type="button" class="btn blue-hoki btn-outline sbold uppercase" id="generarAnexo3"><i class="fa fa-file-text-o"></i> Generar Anexo 3</button>
                                    </div>
                                    <div class="btn-set pull-right">
                                        <button type="button" class="btn blue-hoki btn-outline sbold uppercase" id="mostrar"><i class="fa fa-search"></i> Mostrar Movimientos</button>
                                    </div>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>
                <div class="col-md-9" id="cargar">
                    <!-- BEGIN Portlet PORTLET-->
                    <div class="portlet box blue-hoki">
                        <div class="portlet-title">
                            <div class="caption">
                                Listado de movimientos
                            </div>
                            <div class="tools">
                                <a href="" class="fullscreen"> </a>
                            </div>
                        </div>
                        <div class="portlet-body">   
                            <input type="hidden" id="RequestVerificationToken" name="RequestVerificationToken"
                                   value="@GetAntiXsrfRequestToken()">
                            <div id="gridActivosFijos">
                                <table class="table table-striped table-bordered table-hover">
                                    <thead style="background-color: #444d58 !important; color: #ced5de">
                                        <tr>
                                            <th scope="col" style="text-align:justify">
                                                No. Inv.
                                            </th>
                                            <th scope="col" style="text-align:justify">
                                                Descripci&oacute;n
                                            </th>
                                            <th scope="col" style="text-align:justify">
                                                &Aacute;rea anterior
                                            </th>
                                            <th scope="col" style="text-align:justify">
                                                &Aacute;rea actual
                                            </th>
                                            <th scope="col" style="text-align:justify">
                                                Responsable anterior
                                            </th>
                                            <th scope="col" style="text-align:justify">
                                                Responsable actual
                                            </th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <tr>
                                            <td style="text-align:justify">
                                                <b></b>
                                            </td>
                                            <td style="text-align:justify">
                                                <b></b>
                                            </td>
                                            <td style="text-align:justify">
                                                <b></b>
                                            </td>
                                            <td style="text-align:justify">
                                                <b></b>
                                            </td>
                                            <td style="text-align:justify">
                                                <b></b>
                                            </td>
                                            <td style="text-align:justify">
                                                <b></b>
                                            </td>
                                        </tr>
                                    </tbody>
                                </table>

                            </div>
                        </div>
                    </div>
                    <!-- END Portlet PORTLET-->
                </div>
            </div>
        </div>

        <div id="modalAnexo3" class="modal fade" tabindex="-1" role="dialog" aria-hidden="true">
            <div class="modal-dialog">
                <div class="modal-content">
                    <form asp-action="GenerarAnexosMovimientos" asp-controller="ctActFijos" method="post" id="formGenerarAnexo3">
                        @Html.AntiForgeryToken()
                        <div class="modal-header">
                            <button type="button" class="close" data-dismiss="modal" aria-hidden="true"></button>
                            <h4 class="modal-title">Generar Anexo 3 (SC-1-01)</h4>
                        </div>
                        <div class="modal-body">
                            <input type="hidden" name="Fecha" id="modalAnexo3Fecha" />
                            <input type="hidden" name="Area" id="modalAnexo3Area" />
                            <input type="hidden" name="Responsable" id="modalAnexo3Responsable" />
                            <div class="form-group">
                                <label class="control-label">Tipo de Movimiento:</label>
                                <select class="form-control select2me" id="tipoMovimiento" name="tipoMovimiento">
                                    @foreach (SelectListItem tm in (List<SelectListItem>)ViewData["tiposMovimiento"])
                                    {
                                        if (tm.Selected)
                                        {
                                            <option value="@tm.Value" selected="selected">@tm.Text</option>
                                        }
                                        else
                                        {
                                            <option value="@tm.Value">@tm.Text</option>
                                        }
                                    }
                                </select>
                            </div>
                            <div class="form-group">
                                <label class="control-label">Fundamentaci&oacute;n:</label>
                                <textarea class="form-control" name="fundamentacion" rows="2" autocomplete="off"></textarea>
                            </div>
                            <div class="form-group">
                                <label class="control-label">Informe T&eacute;cnico:</label>
                                <textarea class="form-control" name="informeTecnico" rows="2" autocomplete="off"></textarea>
                            </div>
                            <div class="row">
                                <div class="col-md-6">
                                    <div class="form-group">
                                        <label class="control-label">Nombre:</label>
                                        <select class="form-control select2me" id="NombreTecnico" name="nombreTecnico">
                                            <option value="">Seleccione el nombre</option>
                                            @foreach (SelectListItem usr in (List<SelectListItem>)ViewData["usuarios"])
                                            {
                                                <option value="@usr.Value">@usr.Text</option>
                                            }
                                        </select>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="form-group">
                                        <label class="control-label">Cargo:</label>
                                        <select class="form-control select2me" id="CargoTecnico" name="cargoTecnico">
                                            <option value="">Seleccione el cargo</option>
                                            @foreach (SelectListItem cargo in (List<SelectListItem>)ViewData["cargos"])
                                            {
                                                <option value="@cargo.Value">@cargo.Text</option>
                                            }
                                        </select>
                                    </div>
                                </div>
                            </div>
                            <div class="form-group">
                                <label class="control-label">Comprobante No.:</label>
                                <input type="text" class="form-control" name="comprobante" autocomplete="off" />
                            </div>
                        </div>
                        <div class="modal-footer">
                            <button type="button" class="btn default" data-dismiss="modal">Cancelar</button>
                            <button type="submit" class="btn blue-hoki">Generar</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
        <!-- END PAGE CONTENT INNER -->
    </div>
</div>
<!-- END PAGE CONTENT BODY -->
@section PluginsJS {
    <environment names="Development,Staging,Production">
        <script src="~/global/scripts/datatable.js" type="text/javascript"></script>
        <script src="~/global/plugins/datatables/datatables.min.js" type="text/javascript"></script>
        <script src="~/global/plugins/datatables/plugins/bootstrap/datatables.bootstrap.js" type="text/javascript"></script>

        <script src="~/global/plugins/notifications/noty.min.js"></script>
        <script src="~/global/plugins/jquery-confirm/js/jquery-confirm.js"></script>

        <script type="text/javascript" src="~/global/plugins/moment/min/moment.min.js"></script>
        <script type="text/javascript" src="~/global/plugins/moment/locale/es.js"></script>
        <script src="~/global/plugins/eonasdan-bootstrap-datetimepicker/build/js/bootstrap-datetimepicker.min.js" type="text/javascript"></script>

        <script src="~/global/plugins/select2/js/select2.full.min.js" type="text/javascript"></script>
    </environment>
}

@section Scripts {
    <script src="~/global/paginas/cargandoFiles.js" type="text/javascript"></script>

    <script type="text/javascript">
        var baseUrl = $('base').attr('href'), idFilaSeleccionada = -1, idFilaSeleccionadaAux = "";

        var siSatisfactorio = '@respuesta.SiSatisfactorio';
        var mensaje = '@respuesta.Mensaje';

        if ((siSatisfactorio == "True") && (mensaje != "")) {
            MiApp.Mensajes.mostrarNotificacion("success", mensaje);
        }
        else if ((siSatisfactorio == "False") && (mensaje != "")) {
            MiApp.Mensajes.mostrarNotificacion("error", mensaje);
        }

        var f = new Date('@fch'), anno = @fch.Split('-')[0], mes = @fch.Split('-')[1], dia = @fch.Split('-')[2];

        var fecha = moment(new Date(anno, mes - 1, dia)).format("MM/YYYY");
        document.getElementById('Fecha').value = fecha;

    </script>

    <script src="~/global/paginas/tablaActivosFijosConMovimientos.js" type="text/javascript"></script>

    <script type="text/javascript">

        InicializarSelect2("#Area", "Seleccione el área");
        InicializarSelect2("#Responsable", "Seleccione el responsable");

        $('#datetimepickerImportar').datetimepicker({
            format: 'MM/YYYY',
            locale: 'es',
            maxDate: moment().subtract(1, 'months'),
            viewMode: 'months'
        }).on('dp.change', function (event) {
            var valueFecha = moment(new Date(event.date._d)).format("MM/YYYY");
            CargarAreasPorFecha(valueFecha);
            CargarResponsablesPorFecha(valueFecha);
        });

        $('#mostrar').on('click', function () {
            var valueFecha = $('#Fecha').val();
            CargarTablaActivosFijosConMovimientos(valueFecha);
        });

        $('#Area').on('change', function () {
            var areaResponsabilidad = $('#Area').val();

            $.ajax({
                url: baseUrl + 'ctActFijos/CargarDatosResponsablesPorAreaDeResponsabilidad',
                method: 'POST',
                //async: false,
                data: { area: areaResponsabilidad },
                beforeSend: function (xhr) {
                    xhr.setRequestHeader("XSRF-TOKEN", $('#RequestVerificationToken').val());
                },
                success: function (data) {
                    $('#selectResponsables').html(data);

                    InicializarSelect2("#Responsable", "Seleccione el responsable");
                },
                error: function (err) {
                    console.log(err);
                }

            });

            $.ajax({
                url: baseUrl + 'ctActFijos/CargarInfoResponsableDelArea',
                method: 'POST',
                //async: false,
                data: { area: areaResponsabilidad },
                beforeSend: function (xhr) {
                    xhr.setRequestHeader("XSRF-TOKEN", $('#RequestVerificationToken').val());
                },
                success: function (data) {
                    $('#labelResponsableDelArea').html(data);
                },
                error: function (err) {
                    console.log(err);
                }

            });
        });

        function InicializarSelect2(idSelect2, placeHolder) {
            $.fn.select2.defaults.set("theme", "bootstrap");
            $(idSelect2).select2({
                //allowClear: !0,
                placeholder: placeHolder,
                width: null
            });
        }

        function CargarAreasPorFecha(valueFecha) {
            $.ajax({
                url: baseUrl + 'ctActFijos/ListadoDeAreasPorFecha',
                method: 'POST',
                //async: false,
                data: { fecha: valueFecha, siMovimientos: true },
                beforeSend: function (xhr) {
                    xhr.setRequestHeader("XSRF-TOKEN", $('#RequestVerificationToken').val());
                },
                success: function (data) {
                    $('#selectAreas').html(data);

                    InicializarSelect2("#Area", "Seleccione el área");

                    $('#Area').on('change', function () {
                        var areaResponsabilidad = $('#Area').val();

                        $.ajax({
                            url: baseUrl + 'ctActFijos/ListadoDeResponsablesPorFechaYArea',
                            method: 'POST',
                            //async: false,
                            data: { fecha: $('#Fecha').val(), area: areaResponsabilidad, siMovimiento: true },
                            beforeSend: function (xhr) {
                                xhr.setRequestHeader("XSRF-TOKEN", $('#RequestVerificationToken').val());
                            },
                            success: function (data) {
                                $('#selectResponsables').html(data);

                                InicializarSelect2("#Responsable", "Seleccione el responsable");
                            },
                            error: function (err) {
                                console.log(err);
                            }

                        });

                        $.ajax({
                            url: baseUrl + 'ctActFijos/CargarInfoResponsableDelArea',
                            method: 'POST',
                            //async: false,
                            data: { area: areaResponsabilidad },
                            beforeSend: function (xhr) {
                                xhr.setRequestHeader("XSRF-TOKEN", $('#RequestVerificationToken').val());
                            },
                            success: function (data) {
                                $('#labelResponsableDelArea').html(data);
                            },
                            error: function (err) {
                                console.log(err);
                            }

                        });
                    });
                },
                error: function (err) {
                    console.log(err);
                }

            });
        }

        function CargarResponsablesPorFecha(valueFecha) {
            $.ajax({
                url: baseUrl + 'ctActFijos/ListadoDeResponsablesPorFecha',
                method: 'POST',
                //async: false,
                data: { fecha: valueFecha, siMovimiento: true },
                beforeSend: function (xhr) {
                    xhr.setRequestHeader("XSRF-TOKEN", $('#RequestVerificationToken').val());
                },
                success: function (data) {
                    $('#selectResponsables').html(data);

                    InicializarSelect2("#Responsable", "Seleccione el responsable");
                },
                error: function (err) {
                    console.log(err);
                }

            });
        }
    </script>

    <script type="text/javascript">
        $('#generarAnexo3').on('click', function () {
            var valueFecha = $('#Fecha').val();
            var partes = valueFecha.split('/');
            var año = partes[1], mes = partes[0];

            $('#modalAnexo3Fecha').val(año + '-' + mes + '-01');
            $('#modalAnexo3Area').val(($('#Area').val() != null) ? $('#Area').val() : '');
            $('#modalAnexo3Responsable').val(($('#Responsable').val() != null) ? $('#Responsable').val() : '');

            $('#modalAnexo3').modal('show');
        });

        $('#modalAnexo3').on('shown.bs.modal', function () {
            $('#tipoMovimiento').select2({
                theme: "bootstrap",
                placeholder: "Seleccione el tipo",
                width: null
            });

            $('#NombreTecnico').select2({
                theme: "bootstrap",
                placeholder: "Seleccione el nombre",
                width: null
            });

            $('#CargoTecnico').select2({
                theme: "bootstrap",
                placeholder: "Seleccione el cargo",
                width: null
            });
        });
    </script>
}

