@using ActivosFijos.Clases
@using Microsoft.AspNetCore.Mvc.Rendering
@{
    ViewData["Title"] = "Detalles de los Movimientos";
    Layout = "~/Views/Shared/_Layout.cshtml";

    clResponse<ActivosFijos.Models.Auxiliar.mdActas> respuesta = new clResponse<ActivosFijos.Models.Auxiliar.mdActas>();
    if (ViewBag.respuesta != null)
    {
        respuesta = ViewBag.respuesta;
    }

    string fch = Model.Fecha.ToString("yyyy-MM-dd");
}

@model ActivosFijos.Models.Auxiliar.mdActas

@section PluginsCSS{
    <environment names="Development,Staging,Production">
        <link href="~/global/plugins/datatables/datatables.min.css" rel="stylesheet" type="text/css">
        <link href="~/global/plugins/datatables/plugins/bootstrap/datatables.bootstrap.css" rel="stylesheet" type="text/css">
        <link rel="stylesheet" href="~/global/plugins/jquery-confirm/css/jquery-confirm.css">

        <link href="~/global/plugins/select2/css/select2.min.css" rel="stylesheet" type="text/css" />
        <link href="~/global/plugins/select2/css/select2-bootstrap.min.css" rel="stylesheet" type="text/css" />
    </environment>
}
@section Styles{
    <link rel="stylesheet" href="~/global/paginas/panelAnexo3.css" type="text/css" />
    <style type="text/css">
        .mt-checkbox-list, .mt-radio-list {
            padding: 0 0;
        }
    </style>
}
@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery Xsrf
@functions
{
    public string GetAntiXsrfRequestToken() => Xsrf.GetAndStoreTokens(Context).RequestToken;
}
<div class="page-head">
    <div class="container-fluid">
        <!-- BEGIN PAGE TITLE -->
        <div class="page-title">
            <h1>
                Activos Fijos | Movimientos
            </h1>
        </div>
        <!-- END PAGE TITLE -->
    </div>
</div>
<!-- BEGIN PAGE CONTENT BODY -->
<div class="page-content">
    <div class="container-fluid">
        <!-- BEGIN PAGE BREADCRUMBS -->
        <ul class="page-breadcrumb breadcrumb">
            <li>
                <a asp-action="Inicio" asp-controller="ctInicio">Inicio</a>
                <i class="fa fa-circle"></i>
            </li>
            <li>
                <span>Activos Fijos</span>
                <i class="fa fa-circle"></i>
            </li>
            <li>
                <a asp-action="DetallesDeMovimientos" asp-controller="ctActFijos">Movimientos</a>
                <i class="fa fa-circle"></i>
            </li>
            <li>
                <span>Tabla con los detalles de los movimientos</span>
            </li>
        </ul>
        <!-- END PAGE BREADCRUMBS -->
        <div class="page-content-inner util-btn-margin-bottom-5">
            <div class="row">
                <div class="col-md-3">
                    <div class="portlet box blue-hoki">
                        <div class="portlet-title">
                            <div class="caption">
                                Datos del Movimiento
                            </div>
                            <div class="tools">
                            </div>
                        </div>
                        <div class="portlet-body form">
                            <form asp-action="GenerarActaAFT" asp-controller="ctActFijos" method="post">
                                <div class="form-body">
                                    @Html.AntiForgeryToken()
                                    <div class="form-group">
                                        <label class="control-label" id="etiquetaPeriodo">Submayor:</label>
                                        <input type="text" class="form-control" asp-for="Fecha" readonly="readonly" />
                                        <span class="help-block" id="etiquetaSubmayor"></span>
                                    </div>
                                    <div id="selectAreas">
                                        <partial name="_vpAreas" model="Model" />
                                    </div>
                                    <div id="selectResponsables">
                                        <partial name="_vpResponsables" model="Model" />
                                    </div>
                                </div>
                                <div class="form-actions">
                                    <div class="btn-set pull-left">
                                        <button type="submit" class="btn blue-hoki btn-outline sbold uppercase" id="generarActa"><i class="fa fa-file"></i> Generar Acta</button>
                                        <button type="button" class="btn blue-hoki btn-outline sbold uppercase" id="generarAnexo3"><i class="fa fa-file-text-o"></i> Firmas del Anexo 3</button>
                                    </div>
                                    <div class="btn-set pull-right">
                                        <button type="button" class="btn blue-hoki btn-outline sbold uppercase" id="mostrar"><i class="fa fa-search"></i> Mostrar Movimientos</button>
                                    </div>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>
                <div class="col-md-9" id="cargar">
                    <!-- BEGIN Portlet PORTLET-->
                    <div class="portlet box blue-hoki">
                        <div class="portlet-title">
                            <div class="caption">
                                Listado de movimientos
                            </div>
                            <div class="tools">
                                <a href="" class="fullscreen"> </a>
                            </div>
                        </div>
                        <div class="portlet-body">   
                            <input type="hidden" id="RequestVerificationToken" name="RequestVerificationToken"
                                   value="@GetAntiXsrfRequestToken()">
                            <div id="gridActivosFijos">
                                <table class="table table-striped table-bordered table-hover">
                                    <thead style="background-color: #444d58 !important; color: #ced5de">
                                        <tr>
                                            <th scope="col" style="text-align:justify">
                                                No. Inv.
                                            </th>
                                            <th scope="col" style="text-align:justify">
                                                Descripci&oacute;n
                                            </th>
                                            <th scope="col" style="text-align:justify">
                                                &Aacute;rea anterior
                                            </th>
                                            <th scope="col" style="text-align:justify">
                                                &Aacute;rea actual
                                            </th>
                                            <th scope="col" style="text-align:justify">
                                                Responsable anterior
                                            </th>
                                            <th scope="col" style="text-align:justify">
                                                Responsable actual
                                            </th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <tr>
                                            <td style="text-align:justify">
                                                <b></b>
                                            </td>
                                            <td style="text-align:justify">
                                                <b></b>
                                            </td>
                                            <td style="text-align:justify">
                                                <b></b>
                                            </td>
                                            <td style="text-align:justify">
                                                <b></b>
                                            </td>
                                            <td style="text-align:justify">
                                                <b></b>
                                            </td>
                                            <td style="text-align:justify">
                                                <b></b>
                                            </td>
                                        </tr>
                                    </tbody>
                                </table>

                            </div>
                        </div>
                    </div>
                    <!-- END Portlet PORTLET-->
                </div>
            </div>
        </div>

        <!-- Panel lateral: firmas del Anexo 3 por movimiento -->
<div class="ax3-overlay" id="ax3Overlay"></div>
<div class="ax3-panel" id="ax3Panel">
    <div class="ax3-panel-header">
        <span id="ax3PanelTitulo">Anexo 3 (SC-1-01) - Firmas por movimiento</span>
        <button type="button" class="close" id="ax3Cerrar" aria-label="Close">
            <i class="fa fa-times"></i>
        </button>
    </div>
    <div class="ax3-panel-body">
        <p class="ax3-instruccion">
            Marc&aacute; un movimiento en la tabla para cargarle las firmas. Con varios marcados,
            us&aacute; los botones para recorrerlos.
        </p>
        <form id="formGenerarAnexo3" asp-action="GenerarAnexosMovimientos" asp-controller="ctActFijos" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" name="Fecha" id="ax3Fecha" />
            <input type="hidden" name="Area" id="ax3Area" />
            <input type="hidden" name="Responsable" id="ax3Responsable" />
            <input type="hidden" name="movimientos" id="ax3Movimientos" />

            <div class="alert alert-info">
                <b>Aprobado por</b> y <b>Autorizado por</b> son fijos: el Director y el Encargado de Econom&iacute;a.
                El resto se llena por movimiento.
            </div>

            <div class="ax3-fijos" id="ax3Fijos">
                <div class="ax3-fijo">
                    <span class="ax3-fijo-label">Aprobado por</span>
                    <span class="ax3-fijo-valor" id="ax3AprobadoPor">-</span>
                    <span class="ax3-fijo-cargo" id="ax3CargoAprobadoPor"></span>
                </div>
                <div class="ax3-fijo">
                    <span class="ax3-fijo-label">Autorizado por</span>
                    <span class="ax3-fijo-valor" id="ax3AutorizadoPor">-</span>
                    <span class="ax3-fijo-cargo" id="ax3CargoAutorizadoPor"></span>
                </div>

                <!-- Receptor: depende del movimiento, por eso lo arma el JS al navegar.
                     Nombre y Area son editables: el usuario puede cambiar quien recepciona
                     sin depender de lo que el submayor calculo. -->
                <div class="ax3-receptor" id="ax3Receptor" style="display:none">
                    <div class="ax3-receptor-titulo">Receptor</div>
                    <div class="ax3-fijo">
                        <span class="ax3-fijo-label">Nombre</span>
                        <span class="ax3-fijo-dato" id="ax3ReceptorNombre"></span>
                    </div>
                    <div class="ax3-fijo">
                        <span class="ax3-fijo-label">Direcci&oacute;n</span>
                        <span class="ax3-fijo-dato" id="ax3ReceptorDireccion">-</span>
                    </div>
                    <div class="ax3-fijo">
                        <span class="ax3-fijo-label">&Aacute;rea</span>
                        <span class="ax3-fijo-dato" id="ax3ReceptorArea"></span>
                    </div>
                </div>
            </div>

            <div class="ax3-navegacion" id="ax3Navegacion" style="display:none">
                <div class="ax3-nav-botones">
                    <button type="button" class="btn btn-sm default" id="ax3Anterior" disabled>
                        <i class="fa fa-arrow-left"></i> Anterior
                    </button>
                    <span class="ax3-posicion" id="ax3Posicion"></span>
                    <button type="button" class="btn btn-sm default" id="ax3Siguiente">
                        Siguiente <i class="fa fa-arrow-right"></i>
                    </button>
                </div>
                <div class="ax3-nav-movimiento">
                    <span class="ax3-nav-no" id="ax3MovActual"></span>
                    <span class="ax3-nav-desc" id="ax3DescActual"></span>
                </div>
            </div>

            <div class="ax3-bulk">
                <span id="ax3Contador">0 movimientos</span>
                <div>
                    <button type="button" class="btn btn-xs default" id="ax3MarcarTodos"><i class="fa fa-check"></i> Marcar todos</button>
                    <button type="button" class="btn btn-xs default" id="ax3DesmarcarTodos"><i class="fa fa-unchecked"></i> Desmarcar</button>
                </div>
            </div>

            <!-- Solo aparece si 2 o mas marcados comparten tipo de movimiento y receptor -->
            <div class="ax3-modo" id="ax3ModoWrap" style="display:none">
                <span class="ax3-modo-titulo">Generar</span>
                <label class="ax3-modo-opcion">
                    <input type="radio" name="modo" value="por-activo" checked="checked" />
                    Un anexo por activo
                </label>
                <label class="ax3-modo-opcion">
                    <input type="radio" name="modo" value="agrupado" />
                    Un solo anexo con reverso
                </label>
                <span class="ax3-modo-ayuda">Junta los activos del mismo receptor en una sola plana.</span>
            </div>

            <div id="ax3Formulario"></div>
        </form>
    </div>
    <div class="ax3-panel-footer">
        <button type="button" class="btn btn-block btn-primary" id="ax3Generar"><i class="fa fa-file-text-o"></i> Generar Anexos de los marcados</button>
    </div>
</div>
<!-- END PAGE CONTENT INNER -->
    </div>
</div>
<!-- END PAGE CONTENT BODY -->
@section PluginsJS {
    <environment names="Development,Staging,Production">
        <script src="~/global/scripts/datatable.js" type="text/javascript"></script>
        <script src="~/global/plugins/datatables/datatables.min.js" type="text/javascript"></script>
        <script src="~/global/plugins/datatables/plugins/bootstrap/datatables.bootstrap.js" type="text/javascript"></script>

        <script src="~/global/plugins/notifications/noty.min.js"></script>
        <script src="~/global/plugins/jquery-confirm/js/jquery-confirm.js"></script>

        <script type="text/javascript" src="~/global/plugins/moment/min/moment.min.js"></script>

        <script src="~/global/plugins/select2/js/select2.full.min.js" type="text/javascript"></script>
    </environment>
}

@section Scripts {
    <script src="~/global/paginas/cargandoFiles.js" type="text/javascript"></script>

    <script type="text/javascript">
        var baseUrl = $('base').attr('href'), idFilaSeleccionada = -1, idFilaSeleccionadaAux = "";

        var siSatisfactorio = '@respuesta.SiSatisfactorio';
        var mensaje = '@respuesta.Mensaje';

        if ((siSatisfactorio == "True") && (mensaje != "")) {
            MiApp.Mensajes.mostrarNotificacion("success", mensaje);
        }
        else if ((siSatisfactorio == "False") && (mensaje != "")) {
            MiApp.Mensajes.mostrarNotificacion("error", mensaje);
        }

        var f = new Date('@fch'), anno = @fch.Split('-')[0], mes = @fch.Split('-')[1], dia = @fch.Split('-')[2];

        var fecha = moment(new Date(anno, mes - 1, dia)).format("MM/YYYY");
        document.getElementById('Fecha').value = fecha;

    </script>

    <script src="~/global/paginas/tablaActivosFijosConMovimientos.js" type="text/javascript"></script>

    <script type="text/javascript">

        InicializarSelect2("#Area", "Seleccione el área");
        InicializarSelect2("#Responsable", "Seleccione el responsable");

        // El periodo es fijo: el ultimo submayor importado. Por eso no se inicializa el
        // datetimepicker de la fecha, que ademas estaba limitado al mes anterior al de hoy.
        var MESES = ['Enero', 'Febrero', 'Marzo', 'Abril', 'Mayo', 'Junio', 'Julio',
            'Agosto', 'Septiembre', 'Octubre', 'Noviembre', 'Diciembre'];
        var partesFecha = fecha.split('/');
        $('#etiquetaSubmayor').text('Submayor de ' + MESES[parseInt(partesFecha[1], 10) - 1] +
            ' ' + partesFecha[0] + ' (último importado)');

        $('#mostrar').on('click', function () {
            var valueFecha = $('#Fecha').val();
            CargarTablaActivosFijosConMovimientos(valueFecha);
        });

        $('#Area').on('change', function () {
            var areaResponsabilidad = $('#Area').val();

            $.ajax({
                url: baseUrl + 'ctActFijos/CargarDatosResponsablesPorAreaDeResponsabilidad',
                method: 'POST',
                //async: false,
                data: { area: areaResponsabilidad },
                beforeSend: function (xhr) {
                    xhr.setRequestHeader("XSRF-TOKEN", $('#RequestVerificationToken').val());
                },
                success: function (data) {
                    $('#selectResponsables').html(data);

                    InicializarSelect2("#Responsable", "Seleccione el responsable");
                },
                error: function (err) {
                    console.log(err);
                }

            });

            $.ajax({
                url: baseUrl + 'ctActFijos/CargarInfoResponsableDelArea',
                method: 'POST',
                //async: false,
                data: { area: areaResponsabilidad },
                beforeSend: function (xhr) {
                    xhr.setRequestHeader("XSRF-TOKEN", $('#RequestVerificationToken').val());
                },
                success: function (data) {
                    $('#labelResponsableDelArea').html(data);
                },
                error: function (err) {
                    console.log(err);
                }

            });
        });

        function InicializarSelect2(idSelect2, placeHolder) {
            $.fn.select2.defaults.set("theme", "bootstrap");
            $(idSelect2).select2({
                //allowClear: !0,
                placeholder: placeHolder,
                width: null
            });
        }
    </script>

    <script type="text/javascript">
        $('#generarAnexo3').on('click', function () {
            AbrirPanelAnexo3();
        });
    </script>
    <script src="~/global/paginas/panelAnexo3.js" type="text/javascript"></script>
}

