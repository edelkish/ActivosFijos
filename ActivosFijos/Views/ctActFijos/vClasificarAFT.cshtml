@using ActivosFijos.Clases
@{
    ViewData["Title"] = "Clasificación de Activos Fijos";
    Layout = "~/Views/Shared/_Layout.cshtml";

    clResponse<ActivosFijos.Models.Auxiliar.mdActas> respuesta = new clResponse<ActivosFijos.Models.Auxiliar.mdActas>();
    if (ViewBag.respuesta != null)
    {
        respuesta = ViewBag.respuesta;
    }
}

@model ActivosFijos.Models.Auxiliar.mdActas

@section PluginsCSS {
    <environment names="Development,Staging,Production">
        <link href="~/global/plugins/datatables/datatables.min.css" rel="stylesheet" type="text/css">
        <link href="~/global/plugins/datatables/plugins/bootstrap/datatables.bootstrap.css" rel="stylesheet" type="text/css">
        <link rel="stylesheet" href="~/global/plugins/jquery-confirm/css/jquery-confirm.css">

        <link href="~/global/plugins/eonasdan-bootstrap-datetimepicker/build/css/bootstrap-datetimepicker.min.css" rel="stylesheet" type="text/css" />

        <link href="~/global/plugins/select2/css/select2.min.css" rel="stylesheet" type="text/css" />
        <link href="~/global/plugins/select2/css/select2-bootstrap.min.css" rel="stylesheet" type="text/css" />
    </environment>
}
@section Styles {
    <link rel="stylesheet" href="~/global/plugins/jqwidgets/styles/jqx.base.css" type="text/css" />

    <style type="text/css">
        .mt-checkbox-list, .mt-radio-list {
            padding: 0 0;
        }
    </style>
}
@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery Xsrf
@functions
{
    public string GetAntiXsrfRequestToken() => Xsrf.GetAndStoreTokens(Context).RequestToken;
}
<div class="page-head">
    <div class="container-fluid">
        <!-- BEGIN PAGE TITLE -->
        <div class="page-title">
            <h1>
                Activos Fijos | Clasificar
            </h1>
        </div>
        <!-- END PAGE TITLE -->
    </div>
</div>
<!-- BEGIN PAGE CONTENT BODY -->
<div class="page-content">
    <div class="container-fluid">
        <!-- BEGIN PAGE BREADCRUMBS -->
        <ul class="page-breadcrumb breadcrumb">
            <li>
                <a asp-action="Inicio" asp-controller="ctInicio">Inicio</a>
                <i class="fa fa-circle"></i>
            </li>
            <li>
                <span>Activos Fijos</span>
                <i class="fa fa-circle"></i>
            </li>
            <li>
                <a asp-action="ClasificacionAFT" asp-controller="ctActFijos">Clasificar</a>
                <i class="fa fa-circle"></i>
            </li>
            <li>
                <span>Clasificaci&oacute;n de los AFT</span>
            </li>
        </ul>
        <!-- END PAGE BREADCRUMBS -->
        <div class="page-content-inner util-btn-margin-bottom-5">
            <div class="row">
                <div class="col-md-4">
                    <div class="portlet box blue-hoki">
                        <div class="portlet-title">
                            <div class="caption">
                                Listado de Clasificadores
                            </div>
                            <div class="tools">
                            </div>
                        </div>
                        <div class="portlet-body">
                            <div id="gridClasificadores">
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-md-8" id="cargar">
                    <div class="row">
                        <div class="col-md-12">
                            <!-- BEGIN Portlet PORTLET-->
                            <div class="portlet box blue-hoki">
                                <div class="portlet-title">
                                    <div class="caption">
                                        AFT sin clasificar
                                    </div>
                                    <div class="tools">
                                        <a href="" class="fullscreen"> </a>
                                    </div>
                                </div>
                                <div class="portlet-body">
                                    <input type="hidden" id="RequestVerificationToken" name="RequestVerificationToken"
                                           value="@GetAntiXsrfRequestToken()">
                                    <div class="row">
                                        <div class="col-md-12 col-sm-12 col-xs-12">
                                            <div class="form-group">
                                                <button type="button" id="btnAsociar" class="btn btn-block blue-hoki btn-outline sbold uppercase"><i class="fa fa-arrow-down"></i> Clasificar activos fijos seleccionados <i class="fa fa-arrow-down"></i></button>
                                            </div>
                                        </div>
                                    </div>
                                    <div id="jqxGridAFTSinClasificar">

                                    </div>
                                </div>
                            </div>
                            <!-- END Portlet PORTLET-->
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-12">
                            <!-- BEGIN Portlet PORTLET-->
                            <div class="portlet box blue-hoki">
                                <div class="portlet-title">
                                    <div class="caption">
                                        AFT clasificados
                                    </div>
                                    <div class="tools">
                                        <a href="" class="fullscreen"> </a>
                                    </div>
                                </div>
                                <div class="portlet-body">
                                    <input type="hidden" id="RequestVerificationToken" name="RequestVerificationToken"
                                           value="@GetAntiXsrfRequestToken()">
                                    <div class="row">
                                        <div class="col-md-12 col-sm-12 col-xs-12">
                                            <div class="form-group">
                                                <button type="button" id="btnCancelarClasificacion" class="btn btn-block blue-hoki btn-outline sbold uppercase"><i class="fa fa-arrow-down"></i> Desclasificar activos fijos seleccionados <i class="fa fa-arrow-down"></i></button>
                                            </div>
                                        </div>
                                    </div>
                                    <div id="jqxGridAFTClasificados">

                                    </div>
                                </div>
                            </div>
                            <!-- END Portlet PORTLET-->
                        </div>
                    </div>

                </div>
            </div>
        </div>
        <!-- END PAGE CONTENT INNER -->
    </div>
</div>

@section PluginsJS {
    <environment names="Development,Staging,Production">
        <script src="~/global/scripts/datatable.js" type="text/javascript"></script>
        <script src="~/global/plugins/datatables/datatables.min.js" type="text/javascript"></script>
        <script src="~/global/plugins/datatables/plugins/bootstrap/datatables.bootstrap.js" type="text/javascript"></script>

        <script src="~/global/plugins/notifications/noty.min.js"></script>
        <script src="~/global/plugins/jquery-confirm/js/jquery-confirm.js"></script>
    </environment>
}

@section Scripts {
    <script src="~/global/paginas/cargandoFiles.js" type="text/javascript"></script>

    <script type="text/javascript" src="~/global/plugins/jqwidgets/jqxcore.js"></script>
    <script type="text/javascript" src="~/global/plugins/jqwidgets/jqxdata.js"></script>
    <script type="text/javascript" src="~/global/plugins/jqwidgets/jqxbuttons.js"></script>
    <script type="text/javascript" src="~/global/plugins/jqwidgets/jqxscrollbar.js"></script>
    <script type="text/javascript" src="~/global/plugins/jqwidgets/jqxmenu.js"></script>
    <script type="text/javascript" src="~/global/plugins/jqwidgets/jqxcheckbox.js"></script>
    <script type="text/javascript" src="~/global/plugins/jqwidgets/jqxlistbox.js"></script>
    <script type="text/javascript" src="~/global/plugins/jqwidgets/jqxdropdownlist.js"></script>
    <script type="text/javascript" src="~/global/plugins/jqwidgets/jqxgrid.js"></script>
    <script type="text/javascript" src="~/global/plugins/jqwidgets/jqxgrid.filter.js"></script>
    <script type="text/javascript" src="~/global/plugins/jqwidgets/jqxgrid.sort.js"></script>
    <script type="text/javascript" src="~/global/plugins/jqwidgets/jqxgrid.selection.js"></script>
    <script type="text/javascript" src="~/global/plugins/jqwidgets/jqxgrid.pager.js"></script>
    <script type="text/javascript" src="~/global/scripts/localization.js"></script>
    <script type="text/javascript" src="~/global/scripts/demo.js"></script>

    <script type="text/javascript">
        var baseUrl = $('base').attr('href'), idFilaSeleccionada = -1, idFilaSeleccionadaAux = "";

        var siSatisfactorio = '@respuesta.SiSatisfactorio';
        var mensaje = '@respuesta.Mensaje';

        if ((siSatisfactorio == "True") && (mensaje != "")) {
            MiApp.Mensajes.mostrarNotificacion("success", mensaje);
        }
        else if ((siSatisfactorio == "False") && (mensaje != "")) {
            MiApp.Mensajes.mostrarNotificacion("error", mensaje);
        }
    </script>

    <script src="~/global/paginas/tablaClasificacionAFT.js" type="text/javascript"></script>
}