@model IEnumerable<ActivosFijos.Models.AuxBD.ActivosFijosClasificados>
@{
    string colorDeTexto = string.Empty;
    string styleTexto = string.Empty;
}

<table class="table table-striped table-bordered table-hover" id="tablaActivosFijosClasificados">
    <thead style="background-color: #444d58 !important; color: #ced5de">
        <tr>
            <th scope="col" style="text-align:justify;min-width:75px" width="75px">
                No. Inv.
            </th>
            <th scope="col" style="text-align:justify;min-width:250px" width="350px">
                Descripci&oacute;n
            </th>            
            <th scope="col" style="text-align:justify;min-width:175px" width="250px">
                Centro Costo
            </th>
            <th scope="col" style="text-align:justify;min-width:175px" width="250px">
                Clasificador
            </th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {               
            <tr data-info="@item.noInventario" style="">
                <td style="text-align:justify">
                    @Html.DisplayFor(modelItem => item.noInventario)
                </td style="text-align:justify">
                <td>
                    @Html.DisplayFor(modelItem => item.descripcion)
                </td>                             
                <td style="text-align:justify">
                    @Html.DisplayFor(modelItem => item.nombre)
                </td>                
                <td style="text-align:justify">
                    @Html.DisplayFor(modelItem => item.clasificador)
                </td>   
            </tr>
        }
    </tbody>
</table>