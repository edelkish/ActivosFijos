@using ActivosFijos.Models.Vistas

@model mdLogin
@{
    ViewData["Title"] = "Autenticación de usuarios";
    Layout = "~/Views/Shared/_Layout_Login.cshtml";
}

<!-- BEGIN LOGIN FORM -->
<form class="login-form" asp-action="Autenticarse" asp-controller="ctAutenticacion" asp-antiforgery="true" method="post" id="frmLogin">
    <input type="hidden" id="returnUrl" name="returnUrl" value="@ViewBag?.ReturnUrl" />
    <h3 class="form-title font-orange-custom"><b>Autenticaci&oacute;n</b></h3>
    <div class="alert alert-danger display-hide">
        <button class="close" data-close="alert"></button>
        <span> Entre un usuario y una contrase&ntilde;a. </span>
        <span id="global-error">@Html.ValidationSummary()</span>
    </div>
    <div class="form-group">
        <label class="control-label visible-ie8 visible-ie9">Username</label>
        <input class="form-control form-control-solid placeholder-no-fix" type="text" asp-for="nombreUsuario" autocomplete="off" placeholder="Usuario" />
        <span id="nombreUsuario-error" class="help-block" style="color:red">@Html.ValidationMessage("nombreUsuario")</span>
    </div>
    <div class="form-group">
        <label class="control-label visible-ie8 visible-ie9">Password</label>
        <input class="form-control form-control-solid placeholder-no-fix" type="password" asp-for="Password" autocomplete="off" placeholder="Contraseña" />
        <span id="Password-error" class="help-block" style="color:red">@Html.ValidationMessage("Password")</span>
    </div>
    <div class="form-actions" style="text-align:right">
        <button type="submit" class="btn orange-custom btn-outline sbold uppercase"><i class="icon-login"></i>&nbsp;&nbsp;Acceder</button>     
    </div>    
    <div class="create-account">
        @*<p>
            <a href="javascript:;" id="register-btn" class="uppercase">Cambiar contrase&ntilde;a</a>
        </p>*@
    </div>
</form>

@*@section Scripts {
    <script src="~/global/paginas/validacionesAutenticacion.js" type="text/javascript"></script>
}*@

