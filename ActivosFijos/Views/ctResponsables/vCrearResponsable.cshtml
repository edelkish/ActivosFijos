﻿@using ActivosFijos.Clases;
@using ActivosFijos.Models.EntidadesBD;
@using ActivosFijos.Models.Vistas;

@model Responsable

@{
    ViewData["Title"] = "Crear cargo";
    Layout = "~/Views/Shared/_Layout.cshtml";

    ViewBag.tituloDelContenido = ViewData["Title"];
    ViewBag.subTituloDelContenido = "Formulario a llenar para la creación de Responsables";
    clResponse<Responsable> respuesta = new clResponse<Responsable>();
    if (ViewBag.respuesta != null)
    {
        respuesta = ViewBag.respuesta;
    }
}

@section PluginsCSS {
<environment names="Development,Staging,Production">
    <link href="~/global/plugins/select2/css/select2.min.css" rel="stylesheet" type="text/css" />
    <link href="~/global/plugins/select2/css/select2-bootstrap.min.css" rel="stylesheet" type="text/css" />
</environment>
}

<div class="page-head">
    <div class="container-fluid">
        <!-- BEGIN PAGE TITLE -->
        <div class="page-title">
            <h1>
                Responsables | Crear Responsable
            </h1>
        </div>
        <!-- END PAGE TITLE -->
    </div>
</div>
<!-- BEGIN PAGE CONTENT BODY -->
<div class="page-content">
    <div class="container-fluid">
        <!-- BEGIN PAGE BREADCRUMBS -->
        <ul class="page-breadcrumb breadcrumb">
            <li>
                <a asp-action="Inicio" asp-controller="ctInicio">Inicio</a>
                <i class="fa fa-circle"></i>
            </li>
            <li>
                <span>Nomencladores</span>
                <i class="fa fa-circle"></i>
            </li>
            <li>
                <a asp-action="Responsables" asp-controller="ctResponsables">Responsables</a>
                <i class="fa fa-circle"></i>
            </li>
            <li>
                <span>Creaci&oacute;n de nuevos responsables</span>
            </li>
        </ul>
        <!-- END PAGE BREADCRUMBS -->
        <!-- BEGIN PAGE CONTENT INNER -->
        <div class="page-content-inner">
            <div class="row">
                <div class="col-md-12">
                    <div class="portlet box blue-hoki">
                        <div class="portlet-title">
                            <div class="caption">
                                Formulario a llenar
                            </div>
                            <div class="tools">
                                <a href="" class="fullscreen"> </a>
                            </div>
                        </div>
                        <div class="portlet-body form">
                            <!-- BEGIN FORM-->
                            <form asp-action="GuardarResponsable" asp-controller="ctResponsables" id="guardarResponsable">
                                <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                                <div class="form-body">
                                    @Html.AntiForgeryToken()
                                    <div class="form-group">
                                        <label class="control-label">Nombre <span class="required"> (*) </span></label>
                                        <input asp-for="Nombre" type="text" class="form-control" placeholder="Nombre del responsable" autocomplete="off">
                                        <span asp-validation-for="Nombre" class="required"></span>
                                    </div>
                                    <div class="form-group">
                                        <label class="control-label">Apellidos <span class="required"> (*) </span></label>
                                        <input asp-for="Apellidos" type="text" class="form-control" placeholder="Apellidos del responsable" autocomplete="off">
                                        <span asp-validation-for="Apellidos" class="required"></span>
                                    </div>
                                    <div class="form-group">
                                        <label class="control-label">Seleccione el Cargo <span class="required"> (*) </span></label>
                                        <select class="form-control select2" asp-for="Cargo" asp-items="ViewBag.Cargos"></select>
                                        <span asp-validation-for="Cargo" class="required"></span>
                                    </div>
                                    <div class="form-group">
                                        <label class="control-label">Seleccione el &Aacute;rea de Responsabilidad <span class="required"> (*) </span></label>
                                        <select class="form-control select2" asp-for="AreaResponsabilidad" asp-items="ViewBag.Areas"></select>
                                        <span asp-validation-for="AreaResponsabilidad" class="required"></span>
                                    </div>
                                    <div class="form-group">
                                        <label>Jefe del &Aacute;rea</label>
                                        <div class="mt-checkbox-list">
                                            <label class="mt-checkbox mt-checkbox-outline">
                                                S&iacute;/No
                                                <input asp-for="ResponsableDelArea" type="checkbox" >
                                                <span></span>
                                            </label>                                            
                                        </div>
                                    </div>
                                    <div class="form-group">
                                        <label>Encargado de Econom&iacute;a</label>
                                        <div class="mt-checkbox-list">
                                            <label class="mt-checkbox mt-checkbox-outline">
                                                S&iacute;/No
                                                <input asp-for="ResponsableDeEconomia" type="checkbox" >
                                                <span></span>
                                            </label>                                            
                                        </div>
                                    </div>
                                </div>
                                <div class="form-actions">
                                    <div class="btn-set pull-left">
                                        <a asp-action="Responsables" asp-controller="ctResponsables" class="btn blue-hoki btn-outline sbold uppercase"><i class="fa fa-close"></i> Cancelar</a>
                                    </div>
                                    <div class="btn-set pull-right">
                                        <button type="submit" class="btn blue-hoki btn-outline sbold uppercase"><i class="fa fa-check"></i> Guardar cambios</button>
                                    </div>
                                </div>
                            </form>
                            <!-- END FORM-->
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <!-- END PAGE CONTENT INNER -->
    </div>
</div>
<!-- END PAGE CONTENT BODY -->
@section PluginsJS {
<environment names="Development,Staging,Production">
    <script src="~/global/plugins/select2/js/select2.full.min.js" type="text/javascript"></script>
</environment>
}

@section Scripts{
<script type="text/javascript">
    var siSatisfactorio = '@respuesta.SiSatisfactorio';
    var mensaje = '@respuesta.Mensaje';

    InicializarSelect2("#Cargo", "Seleccione el cargo");
    InicializarSelect2("#AreaResponsabilidad", "Seleccione el área");

    function InicializarSelect2(idSelect2, placeHolder) {
        $.fn.select2.defaults.set("theme", "bootstrap");
        $(idSelect2).select2({
            allowClear: !0,
            placeholder: placeHolder,
            width: null
        });
    }
</script>
<script type="text/javascript" src="~/global/scripts/toastr.js"></script>
}

