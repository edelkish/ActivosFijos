
@{
    ViewData["Title"] = "Listado de locales";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section PluginsCSS {
    <environment names="Development,Staging,Production">
        <link href="~/global/plugins/datatables/datatables.min.css" rel="stylesheet" type="text/css">
        <link href="~/global/plugins/datatables/plugins/bootstrap/datatables.bootstrap.css" rel="stylesheet" type="text/css">
        <link rel="stylesheet" href="~/global/plugins/jquery-confirm/css/jquery-confirm.css">
    </environment>
}
@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery Xsrf
@functions
{
    public string GetAntiXsrfRequestToken() => Xsrf.GetAndStoreTokens(Context).RequestToken;
}
<div class="page-head">
    <div class="container-fluid">
        <!-- BEGIN PAGE TITLE -->
        <div class="page-title">
            <h1>
                Activos fijos | Gesti&oacute;n de locales
            </h1>
        </div>
        <!-- END PAGE TITLE -->
    </div>
</div>
<!-- BEGIN PAGE CONTENT BODY -->
<div class="page-content">
    <div class="container-fluid">
        <!-- BEGIN PAGE BREADCRUMBS -->
        <ul class="page-breadcrumb breadcrumb">
            <li>
                <a asp-action="Inicio" asp-controller="ctInicio">Inicio</a>
                <i class="fa fa-circle"></i>
            </li>
            <li>
                <span>Nomencladores</span>
                <i class="fa fa-circle"></i>
            </li>
            <li>
                <a asp-action="Locales" asp-controller="ctLocales">Locales</a>
                <i class="fa fa-circle"></i>
            </li>
            <li>
                <span>Gesti&oacute;n de los locales</span>
            </li>
        </ul>
        <!-- END PAGE BREADCRUMBS -->
        <!-- BEGIN PAGE CONTENT INNER -->
        <div class="page-content-inner">
            <div class="note note-info">
                <p> Los locales representan los espacios f&iacute;sicos dentro de la empresa donde se encuentran los activos fijos. Cada local debe estar asociado a un cub&iacute;culo. </p>
            </div>
        </div>
        <!-- BEGIN PAGE CONTENT INNER -->
        <div class="page-content-inner util-btn-margin-bottom-5">
            <div class="row">
                <div class="col-md-12">
                    <!-- BEGIN Portlet PORTLET-->
                    <div class="portlet box blue-hoki">
                        <div class="portlet-title">
                            <div class="caption">
                                Listado de locales
                            </div>
                            <div class="tools">
                                <a href="" class="fullscreen"> </a>
                            </div>
                        </div>
                        <div class="portlet-body">
                            <div class="clearfix">
                                <p>
                                    <button type="button" id="crear" class="btn grey-mint btn-outline sbold uppercase"><i class="fa fa-plus"></i> Nuevo</button>
                                    <button type="button" id="editar" class="btn grey-mint btn-outline sbold uppercase" disabled><i class="fa fa-pencil"></i> Editar</button>
                                    <button type="button" id="eliminar" class="btn grey-mint btn-outline sbold uppercase" disabled><i class="fa fa-trash"></i> Eliminar</button>
                                    <button type="button" id="refrescar" class="btn grey-mint btn-outline sbold uppercase"><i class="fa fa-refresh"></i> Refrescar</button>
                                </p>
                            </div>
                            <input type="hidden" id="RequestVerificationToken" name="RequestVerificationToken"
                                   value="@GetAntiXsrfRequestToken()">
                            <div id="gridLocales">
                                <table class="table table-striped table-bordered table-hover">
                                    <thead style="background-color: #444d58 !important; color: #ced5de">
                                        <tr>
                                            <th scope="col" style="text-align:justify">
                                                Nombre
                                            </th>
                                            <th scope="col" style="text-align:justify">
                                                Descripci&oacute;n
                                            </th>
                                            <th scope="col" style="text-align:justify">
                                                Cub&iacute;culo
                                            </th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <tr>
                                            <td style="text-align:justify">
                                                <b></b>
                                            </td>
                                            <td style="text-align:justify">
                                                <b></b>
                                            </td>
                                            <td style="text-align:justify">
                                                <b></b>
                                            </td>
                                        </tr>
                                    </tbody>
                                </table>

                            </div>
                        </div>
                    </div>
                    <!-- END Portlet PORTLET-->
                </div>
            </div>
        </div>
        <!-- END PAGE CONTENT INNER -->
    </div>
</div>
<!-- END PAGE CONTENT BODY -->
@section PluginsJS {
    <environment names="Development,Staging,Production">
        <script src="~/global/scripts/datatable.js" type="text/javascript"></script>
        <script src="~/global/plugins/datatables/datatables.min.js" type="text/javascript"></script>
        <script src="~/global/plugins/datatables/plugins/bootstrap/datatables.bootstrap.js" type="text/javascript"></script>

        <script src="~/global/plugins/notifications/noty.min.js"></script>
        <script src="~/global/plugins/jquery-confirm/js/jquery-confirm.js"></script>
    </environment>
}

@section Scripts {
    <script type="text/javascript">
        var baseUrl = $('base').attr('href'), idFilaSeleccionada = -1;
    </script>

    <script src="~/global/paginas/tablaLocales.js" type="text/javascript"></script>

    <script type="text/javascript">
        $('#refrescar').on('click', function () {
            CargarTablaLocales();
        });

        $('#crear').on('click', function () {
            var link = '@Html.Raw(Url.Action("CrearLocal", "ctLocales"))';
            window.location.href = link;
        });

        $('#editar').on('click', function () {
            var link = '@Html.Raw(Url.Action("EditarLocal", "ctLocales", new { id = "idLocal" }))';
            link = link.replace("idLocal", idFilaSeleccionada);
            window.location.href = link;
        });

        $('#eliminar').on('click', function () {
            if (idFilaSeleccionada != null) {
                    $.confirm({
                        title: '!Advertencia de eliminaci&oacute;n!',
                        content: '&iquest;Est&aacute; seguro de que desea eliminar el local seleccionado?',
                        icon: 'fa fa-warning',
                        type: 'red',
                        theme: 'light',
                        animation: 'news',
                        closeAnimation: 'news',
                        buttons: {
                            tryAgain: {
                                text: 'Eliminar',
                                btnClass: 'btn-red',
                                action: function () {
                                    $.ajax({
                                        url: baseUrl + 'ctLocales/EliminarLocal',
                                        method: "POST",
                                        data: { id: idFilaSeleccionada },
                                        beforeSend: function (xhr) {
                                            xhr.setRequestHeader("XSRF-TOKEN", $('#RequestVerificationToken').val());
                                        },
                                        success: function (data) {
                                            if (data.siNo) {
                                                MiApp.Mensajes.mostrarNotificacion("success", data.objMensaje);
                                                CargarTablaLocales();
                                            } else {
                                                MiApp.Mensajes.mostrarNotificacion("error", data.objMensaje);
                                            }
                                        },
                                        error: function (error) {
                                            MiApp.Mensajes.mostrarNotificacion("error", error);
                                        }
                                    });
                                }
                            },
                            cancelar: function () {

                            }
                        }
                    });
                } else {
                    $.confirm({
                        title: '!Operaci&oacute;n incorrecta!',
                        content: 'Debe seleccionar un local para que la operaci&oacute;n sea v&aacute;lida.',
                        icon: 'fa fa-warning',
                        type: 'red',
                        theme: 'supervan',
                        animation: 'news',
                        closeAnimation: 'news',
                        buttons: {
                            omg: {
                                text: 'Intentar nuevamente',
                                btnClass: 'btn-red',
                            }
                        }
                    });
                }
        });
    </script>
}
