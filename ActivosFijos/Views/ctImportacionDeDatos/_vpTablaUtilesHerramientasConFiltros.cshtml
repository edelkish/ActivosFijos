@using System.Data;
@using ActivosFijos.Clases;
@model DataTable

@{
    DataTable listado = new DataTable();
    listado = Model ?? new DataTable();

    clResponse<DataTable> respuesta = new clResponse<DataTable>();
    if (ViewBag.respuesta != null)
    {
        respuesta = ViewBag.respuesta;
    }
}

<div class="portlet box blue-hoki">
    <div class="portlet-title">
        <div class="caption">
            Submayor de Activos Fijos
        </div>
        <div class="tools">
            <a href="javascript:;" class="collapse"> </a>
        </div>
    </div>
    <div class="portlet-body">
        <table class="table table-bordered table-hover" id="tblExcel">
            <thead style="background-color: #444d58 !important; color: #ced5de">
                <tr>
                    <th style="text-align:justify;min-width:85px;width:85px;"> C&oacute;digo </th>
                    <th style="text-align:justify;min-width:275px;"> Descripci&oacute;n </th>
                    <th style="text-align:justify;min-width:220px;"> Responsable </th>
                    <th style="text-align:justify;min-width:200px;width:200px;"> &Aacute;rea </th>
                    <th style="text-align:justify;min-width:200px;"> Centro Costo </th>
                    <th style="text-align:right;min-width:165px;"> V. Adquisici&oacute;n </th>
                    <th style="text-align:right;min-width:165px;"> V. Contable </th>
                </tr>
            </thead>
            <tbody>
                @{
                    int countRows = 0;

                    double vAdquisicion = 0;
                    double vContable = 0;

                    string classFilaConErrores = string.Empty;

                    foreach (DataRow row in listado.Rows)
                    {
                        if (row[5].ToString() == string.Empty)
                            classFilaConErrores = "color: red;";
                        else
                            classFilaConErrores = string.Empty;

                        if (!row[0].ToString().Contains("-  Área de responsabilidad: "))
                        {
                            if (!row[0].ToString().Contains("Importe total: "))
                            {
                                try
                                {
                                    if (Int64.TryParse(row[0].ToString(), out _))
                                    {
                                        var cellValue6 = row[6] != null ? double.Parse(row[6].ToString()) : 0;
                                        var cellValue7 = row[7] != null ? double.Parse(row[7].ToString()) : 0;

                                        vAdquisicion += cellValue6;
                                        vContable += cellValue7;

                                        //var vAdq = Math.Round(Convert.ToDouble(cellValue), 3);
                                        <tr data-info="@row[2].ToString()" style="@classFilaConErrores">
                                            <td style="text-align:justify;vertical-align:middle;">@row[1].ToString()</td>
                                            <td style="text-align:justify;vertical-align:middle;">@row[2].ToString()</td>
                                            <td style="text-align:justify;vertical-align:middle;">@row[5].ToString()</td>
                                            <td style="text-align:justify;vertical-align:middle;">@row[9].ToString()</td>
                                            <td style="text-align:justify;vertical-align:middle;">@row[4].ToString()</td>
                                            <td style="text-align:right;vertical-align:middle;">@String.Format("{0:#,##0.##}", Math.Round(cellValue6, 3))</td>
                                            <td style="text-align:right;vertical-align:middle;">@String.Format("{0:#,##0.##}", Math.Round(cellValue7, 3))</td>
                                        </tr>

                                        countRows++;
                                    }
                                }
                                catch (Exception ex)
                                {
                                    continue;
                                }
                            }
                            else
                            {
                                break;
                            }

                        }
                    }
                }
            </tbody>
            <tfoot style="background-color:#444d58 !important;color:#FFFFFF;">
                <tr>
                    <td></td>
                    <td></td>
                    <td></td>
                    <td></td>
                    <td></td>
                    <td style="text-align:right;vertical-align:middle;">Total = @String.Format("{0:#,##0.##}", Math.Round(vAdquisicion, 3))</td>
                    <td style="text-align:right;vertical-align:middle;">Total = @String.Format("{0:#,##0.##}", Math.Round(vContable, 3))</td>
                </tr>
            </tfoot>
        </table>
    </div>
</div>
