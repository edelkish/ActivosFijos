@{
    ViewData["Title"] = "Gestión de ubicaciones";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Styles {
    <link rel="stylesheet" href="~/global/paginas/gestorUbicaciones.css" type="text/css" />
    <link rel="stylesheet" href="~/global/plugins/jqwidgets/styles/jqx.base.css" type="text/css" />
}
@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery Xsrf
@functions
{
    public string GetAntiXsrfRequestToken() => Xsrf.GetAndStoreTokens(Context).RequestToken;
}
<div class="page-head">
    <div class="container-fluid">
        <!-- BEGIN PAGE TITLE -->
        <div class="page-title">
            <h1>
                Activos Fijos | Gesti&oacute;n de ubicaciones
            </h1>
        </div>
        <!-- END PAGE TITLE -->
    </div>
</div>
<!-- BEGIN PAGE CONTENT BODY -->
<div class="page-content">
    <div class="container-fluid">
        <!-- BEGIN PAGE BREADCRUMBS -->
        <ul class="page-breadcrumb breadcrumb">
            <li>
                <a asp-action="Inicio" asp-controller="ctInicio">Inicio</a>
                <i class="fa fa-circle"></i>
            </li>
            <li>
                <span>Activos Fijos</span>
                <i class="fa fa-circle"></i>
            </li>
            <li>
                <span>Gesti&oacute;n de ubicaciones</span>
            </li>
        </ul>
        <!-- END PAGE BREADCRUMBS -->
        <div class="page-content-inner util-btn-margin-bottom-5">
            <!-- BEGIN GESTOR -->
            <div class="gestor-ubicaciones">
                <div class="gestor-tree-panel">
                    <div class="portlet box blue-hoki">
                        <div class="portlet-title">
                            <div class="caption">
                                <i class="fa fa-sitemap"></i> Ubicaciones
                            </div>
                            <div class="tools">
                                <a href="" class="fullscreen"> </a>
                            </div>
                        </div>
                        <div class="portlet-body">
                            <input type="hidden" id="RequestVerificationToken" name="RequestVerificationToken"
                                   value="@GetAntiXsrfRequestToken()">
                            <div id="arbolUbicaciones" class="gu-arbol"></div>
                        </div>
                    </div>
                </div>

                <div class="gestor-grid-panel">
                    <div class="portlet box blue-hoki">
                        <div class="portlet-title">
                            <div class="caption">
                                <i class="fa fa-desktop"></i>
                                <span id="tituloNivel">Seleccione una ubicaci&oacute;n</span>
                            </div>
                            <div class="tools">
                                <a href="" class="fullscreen"> </a>
                            </div>
                        </div>
                        <div class="portlet-body">
                            <div class="clearfix">
                                <p>
                                    <button type="button" id="btnAsignarMover" class="btn grey-mint btn-outline sbold uppercase" disabled><i class="fa fa-exchange"></i> Asignar / Mover</button>
                                    <button type="button" id="btnHistorial" class="btn grey-mint btn-outline sbold uppercase" disabled><i class="fa fa-history"></i> Historial</button>
                                    <button type="button" id="btnQuitarUbicacion" class="btn grey-mint btn-outline sbold uppercase" disabled><i class="fa fa-eraser"></i> Quitar ubicaci&oacute;n</button>
                                </p>
                            </div>
                            <div id="jqxGridAFTUbicacion">
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <!-- END GESTOR -->
        </div>
        <!-- END PAGE CONTENT INNER -->
    </div>
</div>
<!-- END PAGE CONTENT BODY -->

<!-- Modal Asignar/Mover -->
<div class="modal fade" id="modalAsignar" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-hidden="true"></button>
                <h4 class="modal-title"><i class="fa fa-exchange"></i> Asignar / Mover AFT</h4>
            </div>
            <div class="modal-body">
                <div class="form-group">
                    <label class="control-label">Centro de Costo <span class="required"> (*) </span></label>
                    <select id="ddlCentroCostoDestino" class="form-control">
                        <option value="">-- Seleccione --</option>
                    </select>
                </div>
                <div class="form-group" id="grupoLocalDestino">
                    <label class="control-label">Local <span class="required"> (*) </span></label>
                    <select id="ddlLocalDestino" class="form-control">
                        <option value="">-- Seleccione --</option>
                    </select>
                </div>
                <div class="form-group">
                    <label class="checkbox mt-checkbox mt-checkbox-outline">
                        <input type="checkbox" id="chkAsignarPuesto" />
                        <span></span>
                        Asignar a un puesto de trabajo
                    </label>
                </div>
                <div class="form-group" id="grupoPuestoDestino" style="display:none;">
                    <label class="control-label">Puesto de trabajo <span class="required"> (*) </span></label>
                    <select id="ddlPuestoDestino" class="form-control">
                        <option value="">-- Seleccione --</option>
                    </select>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn dark btn-outline" data-dismiss="modal"><i class="fa fa-close"></i> Cancelar</button>
                <button type="button" id="btnConfirmarAsignar" class="btn blue-hoki btn-outline"><i class="fa fa-check"></i> Asignar</button>
            </div>
        </div>
    </div>
</div>

<!-- Modal Crear / Editar Local y Puesto de Trabajo -->
<div class="modal fade" id="modalNodo" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-hidden="true"></button>
                <h4 class="modal-title"><i class="fa fa-sitemap"></i> <span id="guNodoTitulo">Local</span></h4>
            </div>
            <div class="modal-body">
                <input type="hidden" id="guNodoTipo" />
                <input type="hidden" id="guNodoId" />
                <input type="hidden" id="guNodoIdPadre" />
                <div class="form-group">
                    <label class="control-label"><span id="guNodoEtiquetaPadre">Centro de Costo</span></label>
                    <p class="form-control-static" id="guNodoContexto"></p>
                </div>
                <div class="form-group">
                    <label class="control-label">Nombre <span class="required"> (*) </span></label>
                    <input type="text" id="guNodoNombre" class="form-control" maxlength="150" autocomplete="off" />
                </div>
                <div class="form-group">
                    <label class="control-label">Descripci&oacute;n</label>
                    <textarea id="guNodoDescripcion" class="form-control" rows="3" maxlength="500"></textarea>
                </div>
                <div class="alert alert-danger" id="guNodoError" style="display:none;"></div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn dark btn-outline" data-dismiss="modal"><i class="fa fa-close"></i> Cancelar</button>
                <button type="button" id="btnGuardarNodo" class="btn blue-hoki btn-outline"><i class="fa fa-check"></i> Guardar</button>
            </div>
        </div>
    </div>
</div>

<!-- Panel deslizante Historial -->
<div class="gu-panel-overlay" id="panelHistorialOverlay"></div>
<div class="gu-panel-lateral" id="panelHistorial">
    <div class="gu-panel-header">
        <span id="guPanelTitulo">Historial de ubicaciones</span>
        <button type="button" class="close" id="btnCerrarHistorial" aria-label="Close">
            <i class="fa fa-times"></i>
        </button>
    </div>
    <div class="gu-panel-body" id="guPanelBody">
    </div>
    <div class="gu-panel-footer">
        <button type="button" id="btnCerrarHistorialFooter" class="btn dark btn-outline btn-block"><i class="fa fa-close"></i> Cerrar</button>
    </div>
</div>

@section PluginsCSS {
    <environment names="Development,Staging,Production">
        <link rel="stylesheet" href="~/global/plugins/jquery-confirm/css/jquery-confirm.css">
    </environment>
}

@section PluginsJS {
    <environment names="Development,Staging,Production">
        <script src="~/global/plugins/notifications/noty.min.js"></script>
        <script src="~/global/plugins/jquery-confirm/js/jquery-confirm.js"></script>
        <script type="text/javascript" src="~/global/plugins/jqwidgets/jqxcore.js"></script>
        <script type="text/javascript" src="~/global/plugins/jqwidgets/jqxdata.js"></script>
        <script type="text/javascript" src="~/global/plugins/jqwidgets/jqxbuttons.js"></script>
        <script type="text/javascript" src="~/global/plugins/jqwidgets/jqxscrollbar.js"></script>
        <script type="text/javascript" src="~/global/plugins/jqwidgets/jqxmenu.js"></script>
        <script type="text/javascript" src="~/global/plugins/jqwidgets/jqxcheckbox.js"></script>
        <script type="text/javascript" src="~/global/plugins/jqwidgets/jqxlistbox.js"></script>
        <script type="text/javascript" src="~/global/plugins/jqwidgets/jqxdropdownlist.js"></script>
        <script type="text/javascript" src="~/global/plugins/jqwidgets/jqxgrid.js"></script>
        <script type="text/javascript" src="~/global/plugins/jqwidgets/jqxgrid.filter.js"></script>
        <script type="text/javascript" src="~/global/plugins/jqwidgets/jqxgrid.sort.js"></script>
        <script type="text/javascript" src="~/global/plugins/jqwidgets/jqxgrid.selection.js"></script>
        <script type="text/javascript" src="~/global/plugins/jqwidgets/jqxgrid.pager.js"></script>
        <script type="text/javascript" src="~/global/scripts/localization.js"></script>
        <script type="text/javascript" src="~/global/scripts/demo.js"></script>
    </environment>
}

@section Scripts {
    <script type="text/javascript">
        var baseUrl = $('base').attr('href');
        var nodoSeleccionado = null;
    </script>
    <script src="~/global/paginas/gestorUbicaciones.js" type="text/javascript"></script>
}