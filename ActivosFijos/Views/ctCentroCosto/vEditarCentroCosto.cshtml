@using ActivosFijos.Clases;
@using ActivosFijos.Models.EntidadesBD;

@model CentroCosto

@{
    ViewData["Title"] = "Editar centro de costo";
    Layout = "~/Views/Shared/_Layout.cshtml";

    ViewBag.tituloDelContenido = ViewData["Title"];
    ViewBag.subTituloDelContenido = "Formulario a llenar para la edición de Centros de Costo";
    clResponse<CentroCosto> respuesta = new clResponse<CentroCosto>();
    if (ViewBag.respuesta != null)
    {
        respuesta = ViewBag.respuesta;
    }
}

@section PluginsCSS {
<environment names="Development,Staging,Production">
    <link href="~/global/plugins/bootstrap-touchspin/bootstrap.touchspin.css" rel="stylesheet" />
</environment>
}

<div class="page-head">
    <div class="container-fluid">
        <!-- BEGIN PAGE TITLE -->
        <div class="page-title">
            <h1>
                Centros de Costo | Editar centro de costo
            </h1>
        </div>
        <!-- END PAGE TITLE -->
    </div>
</div>
<!-- BEGIN PAGE CONTENT BODY -->
<div class="page-content">
    <div class="container-fluid">
        <!-- BEGIN PAGE BREADCRUMBS -->
        <ul class="page-breadcrumb breadcrumb">
            <li>
                <a asp-action="Inicio" asp-controller="ctInicio">Inicio</a>
                <i class="fa fa-circle"></i>
            </li>
            <li>
                <span>Nomencladores</span>
                <i class="fa fa-circle"></i>
            </li>
            <li>
                <a asp-action="CentrosDeCosto" asp-controller="ctCentroCosto">Centros de Costo</a>
                <i class="fa fa-circle"></i>
            </li>
            <li>
                <span>Edici&oacute;n de centros de costo</span>
            </li>
        </ul>
        <!-- END PAGE BREADCRUMBS -->
        <!-- BEGIN PAGE CONTENT INNER -->
        <div class="page-content-inner">
            <div class="row">
                <div class="col-md-12">
                    <div class="portlet box blue-hoki">
                        <div class="portlet-title">
                            <div class="caption">
                                Formulario a llenar
                            </div>
                            <div class="tools">
                                <a href="" class="fullscreen"> </a>
                            </div>
                        </div>
                        <div class="portlet-body form">
                            <!-- BEGIN FORM-->
                            <form asp-action="ModificarCentroCosto" asp-controller="ctCentroCosto" id="modificarCentroDeCosto">
                                <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                                <div class="form-body">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" asp-for="IdCentroCosto" />
                                    <div class="form-group">
                                        <label>Centro de Costo <span class="required"> (*) </span></label>
                                        <input type="text" asp-for="Numero" class="form-control" placeholder="Centro de Costo" autocomplete="off">
                                        <span asp-validation-for="Numero" class="required"></span>
                                    </div>
                                    <div class="form-group">
                                        <label class="control-label">Nombre <span class="required"> (*) </span></label>
                                        <input asp-for="Nombre" type="text" class="form-control" placeholder="Nombre del área" autocomplete="off">
                                        <span asp-validation-for="Nombre" class="required"></span>
                                    </div>
                                </div>
                                <div class="form-actions">
                                    <div class="btn-set pull-left">
                                        <a asp-action="CentrosDeCosto" asp-controller="ctCentroCosto" class="btn blue-hoki btn-outline sbold uppercase"><i class="fa fa-close"></i> Cancelar</a>
                                    </div>
                                    <div class="btn-set pull-right">
                                        <button type="submit" class="btn blue-hoki btn-outline sbold uppercase"><i class="fa fa-check"></i> Guardar cambios</button>
                                    </div>
                                </div>
                            </form>
                            <!-- END FORM-->
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <!-- END PAGE CONTENT INNER -->
    </div>
</div>
<!-- END PAGE CONTENT BODY -->
@section PluginsJS {
<environment names="Development,Staging,Production">
    <script src="~/global/plugins/bootstrap-touchspin/bootstrap.touchspin.js"></script>
</environment>
}


@section Scripts{
<script type="text/javascript">
    var siSatisfactorio = '@respuesta.SiSatisfactorio';
    var mensaje = '@respuesta.Mensaje';

    $("#Numero").TouchSpin({
        verticalbuttons: true,
        min:0,
        max:9000000000
    });
</script>
<script type="text/javascript" src="~/global/scripts/toastr.js"></script>
}
