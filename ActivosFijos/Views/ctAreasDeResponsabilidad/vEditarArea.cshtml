﻿@using ActivosFijos.Clases;
@using ActivosFijos.Models.EntidadesBD;

@model AreaDeResponsabilidad

@{
    ViewData["Title"] = "Editar área";
    Layout = "~/Views/Shared/_Layout.cshtml";

    ViewBag.tituloDelContenido = ViewData["Title"];
    ViewBag.subTituloDelContenido = "Formulario a llenar para la edición de Áreas";
    clResponse<AreaDeResponsabilidad> respuesta = new clResponse<AreaDeResponsabilidad>();
    if (ViewBag.respuesta != null)
    {
        respuesta = ViewBag.respuesta;
    }
}

<div class="page-head">
    <div class="container-fluid">
        <!-- BEGIN PAGE TITLE -->
        <div class="page-title">
            <h1>
                &Aacute;res de Responsabilidad | Editar &Aacute;rea
            </h1>
        </div>
        <!-- END PAGE TITLE -->
    </div>
</div>
<!-- BEGIN PAGE CONTENT BODY -->
<div class="page-content">
    <div class="container-fluid">
        <!-- BEGIN PAGE BREADCRUMBS -->
        <ul class="page-breadcrumb breadcrumb">
            <li>
                <a asp-action="Inicio" asp-controller="ctInicio">Inicio</a>
                <i class="fa fa-circle"></i>
            </li>
            <li>
                <span>Nomencladores</span>
                <i class="fa fa-circle"></i>
            </li>
            <li>
                <a asp-action="Areas" asp-controller="ctAreasDeResponsabilidad">&Aacute;reas de Responsabilidad</a>
                <i class="fa fa-circle"></i>
            </li>
            <li>
                <span>Edici&oacute;n de &aacute;reas existentes</span>
            </li>
        </ul>
        <!-- END PAGE BREADCRUMBS -->
        <!-- BEGIN PAGE CONTENT INNER -->
        <div class="page-content-inner">
            <div class="row">
                <div class="col-md-12">
                    <div class="portlet box blue-hoki">
                        <div class="portlet-title">
                            <div class="caption">
                                Formulario a llenar
                            </div>
                            <div class="tools">
                                <a href="" class="fullscreen"> </a>
                            </div>
                        </div>
                        <div class="portlet-body form">
                            <!-- BEGIN FORM-->
                            <form asp-action="ModificarArea" asp-controller="ctAreasDeResponsabilidad" id="modificarArea">
                                <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                                <div class="form-body">
                                    @Html.AntiForgeryToken()
                                    <input asp-for="IdArea" type="hidden" />
                                    <div class="form-group">
                                        <label class="control-label">Nombre <span class="required"> (*) </span></label>
                                        <input asp-for="Nombre" type="text" class="form-control" placeholder="Nombre del área" autocomplete="off">
                                        <span asp-validation-for="Nombre" class="required"></span>
                                    </div>
                                    <div class="form-group">
                                        <label class="control-label">Descripci&oacute;n <span class="required"> (*) </span></label>
                                        <textarea asp-for="Descripcion" class="form-control" rows="3"></textarea>
                                        <span asp-validation-for="Descripcion" class="required"></span>
                                    </div>
                                </div>
                                <div class="form-actions">
                                    <div class="btn-set pull-left">
                                        <a asp-action="Areas" asp-controller="ctAreasDeResponsabilidad" class="btn blue-hoki btn-outline sbold uppercase"><i class="fa fa-close"></i> Cancelar</a>
                                    </div>
                                    <div class="btn-set pull-right">
                                        <button type="submit" class="btn blue-hoki btn-outline sbold uppercase"><i class="fa fa-check"></i> Guardar cambios</button>
                                    </div>
                                </div>
                            </form>
                            <!-- END FORM-->
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <!-- END PAGE CONTENT INNER -->
    </div>
</div>
<!-- END PAGE CONTENT BODY -->

@section Scripts{
<script type="text/javascript">
    var siSatisfactorio = '@respuesta.SiSatisfactorio';
    var mensaje = '@respuesta.Mensaje';
</script>
<script type="text/javascript" src="~/global/scripts/toastr.js"></script>
}

