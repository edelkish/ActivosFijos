                            <a asp-action="Transferencias" asp-controller="ctActFijos" class="nav-link @Html.IsSelected("ctActFijos", "Transferencias")"> Transferencias </a>
                        </li>
                        <li aria-haspopup="true" class=" @Html.IsSelected("ctActFijos", "Traslados")">
