                                <span class="arrow"></span>
                            </a>
                            <ul class="dropdown-menu">
                                <li aria-haspopup="true" class=" @Html.IsSelected("ctActFijos", "ActivosFijos")">
                                    <a asp-action="ActivosFijos" asp-controller="ctActFijos" class="nav-link @Html.IsSelected("ctActFijos", "ActivosFijos")"> Mensuales por &Aacute;reas y Responsables </a>
                                </li>
                                <li aria-haspopup="true" class=" @Html.IsSelected("ctActFijos", "DetallesDeMovimientos")">
                                    <a asp-action="DetallesDeMovimientos" asp-controller="ctActFijos" class="nav-link @Html.IsSelected("ctActFijos", "DetallesDeMovimientos")"> Movimientos Mensuales </a>
                                </li>
                            </ul>
                        </li>

