                        </li>
                        <li aria-haspopup="true" class=" @Html.IsSelected("ctCubiculos", "Cubiculos")">
                            <a asp-action="Cubiculos" asp-controller="ctCubiculos" class="nav-link @Html.IsSelected("ctCubiculos", "Cubiculos")"> Cub&iacute;culos </a>
                        </li>
                        <li aria-haspopup="true" >
                            <a asp-action="Locales" asp-controller="ctLocales" class="nav-link "> Locales </a>
                        </li>

