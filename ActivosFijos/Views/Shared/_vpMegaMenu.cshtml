                                Historial de Movimientos
                                <span class="arrow"></span>
                            </a>
                            <ul class="dropdown-menu">
                                <li aria-haspopup="true" class=" @Html.IsSelected("ctActFijos", "MovimientosDelAFT")">
                                    <a asp-action="MovimientosDelAFT" asp-controller="ctActFijos" class="nav-link @Html.IsSelected("ctActFijos", "MovimientosDelAFT")"> Por No. Inventario</a>
                                </li>
