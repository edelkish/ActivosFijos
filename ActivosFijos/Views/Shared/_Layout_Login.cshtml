@using ActivosFijos.Helpers
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Activos Fijos</title>
    <base href='@Url.Content("~/")'>
    <environment names="Development">
        <link href="~/global/css/openSans.css" rel="stylesheet" type="text/css" />
        <link href="~/global/plugins/font-awesome/css/font-awesome.css" rel="stylesheet" type="text/css" />
        <link href="~/global/plugins/simple-line-icons/simple-line-icons.css" rel="stylesheet" type="text/css" />
        <link href="~/global/plugins/bootstrap/css/bootstrap.css" rel="stylesheet" type="text/css" />
        <link href="~/global/plugins/bootstrap-switch/css/bootstrap-switch.css" rel="stylesheet" type="text/css" />
        <!-- END GLOBAL MANDATORY STYLES -->
        <!-- BEGIN THEME GLOBAL STYLES -->
        <link href="~/global/css/components.css" rel="stylesheet" id="style_components" type="text/css" />
        <link href="~/global/css/plugins.css" rel="stylesheet" type="text/css" />
        <!-- END THEME GLOBAL STYLES -->
        <!-- BEGIN THEME LAYOUT STYLES -->
        <link href="~/global/css/login.css" rel="stylesheet" type="text/css" />
        <!-- END THEME LAYOUT STYLES -->
        <link rel="shortcut icon" href="~/favicon.ico" />

        <!-- Add local styles, mostly for plugins css file -->
        @if (IsSectionDefined("Styles"))
        {
            @RenderSection("Styles", required: false)
        }
    </environment>

    <environment names="Staging,Production">
        <link href="http://fonts.googleapis.com/css?family=Open+Sans:400,300,600,700&subset=all" rel="stylesheet" type="text/css" />
        <link href="~/global/plugins/font-awesome/css/font-awesome.min.css" rel="stylesheet" type="text/css" />
        <link href="~/global/plugins/simple-line-icons/simple-line-icons.min.css" rel="stylesheet" type="text/css" />
        <link href="~/global/plugins/bootstrap/css/bootstrap.min.css" rel="stylesheet" type="text/css" />
        <link href="~/global/plugins/bootstrap-switch/css/bootstrap-switch.min.css" rel="stylesheet" type="text/css" />
        <!-- END GLOBAL MANDATORY STYLES -->
        <!-- BEGIN THEME GLOBAL STYLES -->
        <link href="~/global/css/components.min.css" rel="stylesheet" id="style_components" type="text/css" />
        <link href="~/global/css/plugins.min.css" rel="stylesheet" type="text/css" />
        <!-- END THEME GLOBAL STYLES -->
        <!-- BEGIN THEME LAYOUT STYLES -->
        <link href="~/global/css/login.min.css" rel="stylesheet" type="text/css" />
        <!-- END THEME LAYOUT STYLES -->
        <link rel="shortcut icon" href="~/favicon.ico" />

        <!-- Add local styles, mostly for plugins css file -->
        @if (IsSectionDefined("Styles"))
        {
            @RenderSection("Styles", required: false)
        }
    </environment>

    <link rel="stylesheet" href="~/css/custom.css" asp-append-version="true" />
</head>
<body class=" login">
    <partial name="_vpLogo" />

    <!-- BEGIN LOGIN -->
    <div class="content">
        @RenderBody()
    </div>
    <div class="copyright"> 2023 © Edelkis. Sistema Activos Fijos Tangibles. </div>
    <!--[if lt IE 9]>

    <environment names="Development">
        <!-- BEGIN CORE PLUGINS -->
        <script src="~/global/plugins/jquery.min.js" type="text/javascript"></script>
        <script src="~/global/plugins/bootstrap/js/bootstrap.js" type="text/javascript"></script>
        <script src="~/global/plugins/js.cookie.min.js" type="text/javascript"></script>
        <script src="~/global/plugins/jquery-slimscroll/jquery.slimscroll.js" type="text/javascript"></script>
        <script src="~/global/plugins/jquery.blockui.min.js" type="text/javascript"></script>
        <script src="~/global/plugins/bootstrap-switch/js/bootstrap-switch.js" type="text/javascript"></script>
        <!-- END CORE PLUGINS -->
        <script src="~/global/plugins/jquery-validation/js/jquery.validate.js" type="text/javascript"></script>
        <script src="~/global/plugins/jquery-validation/js/additional-methods.js" type="text/javascript"></script>
        <!-- BEGIN THEME GLOBAL SCRIPTS -->
        <script src="~/global/scripts/app.js" type="text/javascript"></script>
        <!-- END THEME GLOBAL SCRIPTS -->
        <!-- BEGIN PAGE LEVEL SCRIPTS -->
        <script src="~/global/scripts/login.js" type="text/javascript"></script>
        <!-- END PAGE LEVEL SCRIPTS -->
        @if (IsSectionDefined("Scripts"))
        {
            @RenderSection("Scripts", required: false)
        }

    <!-- BEGIN THEME LAYOUT SCRIPTS -->
    <script src="~/scripts/layout.js" type="text/javascript"></script>
    <script src="~/scripts/demo.js" type="text/javascript"></script>
    <!-- END THEME LAYOUT SCRIPTS -->
    </environment>
    <environment names="Staging,Production">
        <!-- BEGIN CORE PLUGINS -->
        <script src="~/global/plugins/jquery.min.js" type="text/javascript"></script>
        <script src="~/global/plugins/bootstrap/js/bootstrap.min.js" type="text/javascript"></script>
        <script src="~/global/plugins/js.cookie.min.js" type="text/javascript"></script>
        <script src="~/global/plugins/jquery-slimscroll/jquery.slimscroll.min.js" type="text/javascript"></script>
        <script src="~/global/plugins/jquery.blockui.min.js" type="text/javascript"></script>
        <script src="~/global/plugins/bootstrap-switch/js/bootstrap-switch.min.js" type="text/javascript"></script>
        <!-- END CORE PLUGINS -->
        <script src="~/global/plugins/jquery-validation/js/jquery.validate.min.js" type="text/javascript"></script>
        <script src="~/global/plugins/jquery-validation/js/additional-methods.min.js" type="text/javascript"></script>
        <!-- BEGIN THEME GLOBAL SCRIPTS -->
        <script src="~/global/scripts/app.min.js" type="text/javascript"></script>
        <!-- END THEME GLOBAL SCRIPTS -->
        <!-- BEGIN PAGE LEVEL SCRIPTS -->
        <script src="~/global/scripts/login.min.js" type="text/javascript"></script>
        <!-- END PAGE LEVEL SCRIPTS -->
        @if (IsSectionDefined("Scripts"))
        {
            @RenderSection("Scripts", required: false)
        }
    </environment>
</body>
</html>
