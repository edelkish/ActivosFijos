@using ActivosFijos.Clases

@{
    ViewData["Title"] = "Bajas de Activos Fijos";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery Xsrf
@functions
{
    public string GetAntiXsrfRequestToken() => Xsrf.GetAndStoreTokens(Context).RequestToken;
}

@section PluginsCSS{
    <environment names="Development,Staging,Production">
        <link href="~/global/plugins/datatables/datatables.min.css" rel="stylesheet" type="text/css">
        <link href="~/global/plugins/datatables/plugins/bootstrap/datatables.bootstrap.css" rel="stylesheet" type="text/css">
    </environment>
}

@section Styles{
    <style type="text/css">
        .mt-checkbox-list, .mt-radio-list {
            padding: 0 0;
        }
    </style>
}

<div class="page-head">
    <div class="container-fluid">
        <div class="page-title">
            <h1>
                Activos Fijos | Reporte de Bajas en el Año
            </h1>
        </div>
    </div>
</div>

<div class="page-content">
    <div class="container-fluid">
        <ul class="page-breadcrumb breadcrumb">
            <li>
                <a asp-action="Inicio" asp-controller="ctInicio">Inicio</a>
                <i class="fa fa-circle"></i>
            </li>
            <li>
                <span>Activos Fijos</span>
                <i class="fa fa-circle"></i>
            </li>
            <li>
                <span>Reporte de Bajas en el Año</span>
            </li>
        </ul>

        <input type="hidden" id="RequestVerificationToken" value="@GetAntiXsrfRequestToken()">

        <div class="page-content-inner util-btn-margin-bottom-5">
            <div class="row">
                <div class="col-md-12">
                    <div class="portlet box blue-hoki">
                        <div class="portlet-title">
                            <div class="caption">
                                Comparación de Submayores
                            </div>
                        </div>
                        <div class="portlet-body">
                            <div class="row">
                                <div class="col-md-6">
                                    <p>
                                        <strong>Período Origen:</strong> @(((DateTime)ViewBag.FechaOrigen).ToString("MMMM yyyy"))
                                    </p>
                                </div>
                                <div class="col-md-6">
                                    <p>
                                        <strong>Período Destino:</strong> @(((DateTime)ViewBag.FechaDestino).ToString("MMMM yyyy"))
                                    </p>
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-md-12">
                                    <button type="button" class="btn blue" id="btnBuscar" onclick="buscarActivosBaja()">
                                        <i class="fa fa-search"></i> Buscar Activos Baja
                                    </button>
                                    <button type="button" class="btn green" id="btnExportar" onclick="exportarExcel()" style="display:none;">
                                        <i class="fa fa-file-excel-o"></i> Exportar Excel
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="row" id="divResultados" style="display:none;">
                <div class="col-md-12">
                    <div class="portlet box blue-hoki">
                        <div class="portlet-title">
                            <div class="caption">
                                Activos que no existen en el período destino
                            </div>
                        </div>
                        <div class="portlet-body" id="divTablaResultados">
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts{
    <script src="~/global/scripts/datatable.js" type="text/javascript"></script>
    <script src="~/global/plugins/datatables/datatables.min.js" type="text/javascript"></script>
    <script src="~/global/plugins/datatables/plugins/bootstrap/datatables.bootstrap.js" type="text/javascript"></script>

    <script type="text/javascript">
        var tablaResultados = null;

        function buscarActivosBaja() {
            $.ajax({
                url: '@Url.Action("BuscarActivosBaja", "ctBajasActivo")',
                type: 'POST',
                headers: { 'XSRF-TOKEN': $('#RequestVerificationToken').val() },
                success: function (data) {
                    $('#divTablaResultados').html(data);
                    $('#divResultados').show();
                    $('#btnExportar').show();

                    if (tablaResultados) {
                        tablaResultados.destroy();
                    }

                    tablaResultados = $('#tablaBajas').DataTable({
                        "language": {
                            "url": "~/global/plugins/datatables/plugins/i18n/Spanish.json"
                        },
                        "pageLength": 25,
                        "order": [[0, "asc"]]
                    });
                },
                error: function () {
                    MiApp.Mensajes.mostrarNotificacion("error", "Error al consultar los datos.");
                }
            });
        }

        function exportarExcel() {
            window.location.href = '@Url.Action("ExportarExcel", "ctBajasActivo")';
        }

        function seleccionarTodos(checkbox) {
            var rows = tablaResultados.rows().nodes();
            $('.chkSeleccion', rows).prop('checked', checkbox.checked);
        }

        function guardarBajas() {
            var bajas = [];

            $('#tablaBajas tbody tr').each(function () {
                var row = $(this);
                var chk = row.find('.chkSeleccion');
                if (chk.is(':checked')) {
                    bajas.push({
                        NoInventario: row.find('.hdNoInventario').val(),
                        SubNumero: row.find('.hdSubNumero').val(),
                        FechaSubmayor: row.find('.hdFechaSubmayor').val(),
                        MotivoBajaId: row.find('.ddlMotivo').val(),
                        Observaciones: row.find('.txtObservaciones').val(),
                        Seleccionado: true
                    });
                }
            });

            if (bajas.length === 0) {
                MiApp.Mensajes.mostrarNotificacion("warning", "Debe seleccionar al menos un activo.");
                return;
            }

            $.ajax({
                url: '@Url.Action("RegistrarBajas", "ctBajasActivo")',
                type: 'POST',
                headers: { 'XSRF-TOKEN': $('#RequestVerificationToken').val() },
                data: { bajas: bajas },
                success: function (response) {
                    MiApp.Mensajes.mostrarNotificacion("success", "Bajas registradas satisfactoriamente.");
                    buscarActivosBaja();
                },
                error: function () {
                    MiApp.Mensajes.mostrarNotificacion("error", "Error al guardar las bajas.");
                }
            });
        }

        $(document).ready(function () {
            buscarActivosBaja();
        });
    </script>
}
