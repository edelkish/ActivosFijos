@model IEnumerable<ActivosFijos.Models.AuxBD.UTHConMovimientos>
@{
    DateTime fechaSubmayor = ViewBag.FechaSubmayor;
}
<table class="table table-striped table-bordered table-hover" id="tablaUTHs">
    <thead style="background-color: #444d58 !important; color: #ced5de">
        <tr>
            <th scope="col" rowspan="2" style="text-align:justify;min-width:100px" width="100px">
                C&oacute;digo
            </th>
            <th scope="col" rowspan="2" style="text-align:justify;min-width:300px" width="300px">
                Descripci&oacute;n
            </th>            
            <th scope="col" rowspan="2" style="text-align:justify;min-width:225px" width="230px">
                &Aacute;rea
            </th>
            <th scope="col" rowspan="2" style="text-align:justify;min-width:225px" width="230px">
                Responsable
            </th>
            <th scope="col" colspan="2" style="text-align:center;min-width:65px" width="70px">
                Meses
            </th>
        </tr>
        <tr>
            <th scope="col" style="text-align:center">
                @fechaSubmayor.AddMonths(-1).ToShortDateString()
            </th>
            <th scope="col" style="text-align:center">
                @fechaSubmayor.ToShortDateString()
            </th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {                          
            <tr data-info="@item.Discriminante" data-fecha="@fechaSubmayor.ToString("yyyy-MM-dd")">
                <td style="text-align:justify">
                    @Html.DisplayFor(modelItem => item.Codigo)
                </td style="text-align:justify">
                <td>
                    @Html.DisplayFor(modelItem => item.Descripcion)
                </td>                             
                <td style="text-align:justify">
                    @Html.DisplayFor(modelItem => item.Area)
                </td>                
                <td style="text-align:justify">
                    @Html.DisplayFor(modelItem => item.Responsable)
                </td>
                <td style="text-align:center">
                    @Html.DisplayFor(modelItem => item.CantidadAnterior)
                </td>
                <td style="text-align:center">
                    @Html.DisplayFor(modelItem => item.Cantidad)
                </td>   
            </tr>
        }
    </tbody>
</table>
