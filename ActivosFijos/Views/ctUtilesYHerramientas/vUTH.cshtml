@using ActivosFijos.Clases
@{
    ViewData["Title"] = "Listado de útiles y herramientas";
    Layout = "~/Views/Shared/_Layout.cshtml";

    clResponse<ActivosFijos.Models.Auxiliar.mdActas> respuesta = new clResponse<ActivosFijos.Models.Auxiliar.mdActas>();
    if (ViewBag.respuesta != null)
    {
        respuesta = ViewBag.respuesta;
    }

    string fch = Model.Fecha.ToString("yyyy-MM-dd");
}

@model ActivosFijos.Models.Auxiliar.mdActas

