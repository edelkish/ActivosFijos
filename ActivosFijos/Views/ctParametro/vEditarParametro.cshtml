@using ActivosFijos.Clases;
@using ActivosFijos.Models.EntidadesBD;
@using ActivosFijos.Models.Vistas;

@model ActivosFijos.Models.EntidadesBD.Parametro

@{
    ViewData["Title"] = "Editar Parámetro";
    Layout = "~/Views/Shared/_Layout.cshtml";

    ViewBag.tituloDelContenido = ViewData["Title"];
    ViewBag.subTituloDelContenido = "Formulario a llenar para la edición de Parámetros";
    clResponse<Parametro> respuesta = new clResponse<Parametro>();
    if (ViewBag.respuesta != null)
    {
        respuesta = ViewBag.respuesta;
    }
}

<div class="page-head">
    <div class="container-fluid">
        <!-- BEGIN PAGE TITLE -->
        <div class="page-title">
            <h1>
                Par&aacute;metros | Editar
            </h1>
        </div>
        <!-- END PAGE TITLE -->
    </div>
</div>

<!-- BEGIN PAGE CONTENT BODY -->
<div class="page-content">
    <div class="container-fluid">
        <!-- BEGIN PAGE BREADCRUMBS -->
        <ul class="page-breadcrumb breadcrumb">
            <li>
                <a asp-action="Inicio" asp-controller="ctInicio">Inicio</a>
                <i class="fa fa-circle"></i>
            </li>
            <li>
                <span>Configuraci&oacute;n</span>
                <i class="fa fa-circle"></i>
            </li>
            <li>
                <a asp-action="Parametros" asp-controller="ctParametro">Par&aacute;metros</a>
                <i class="fa fa-circle"></i>
            </li>
            <li>
                <span>Edici&oacute;n de par&aacute;metros existentes</span>
            </li>
        </ul>
        <!-- END PAGE BREADCRUMBS -->
        <!-- BEGIN PAGE CONTENT INNER -->
        <div class="page-content-inner">
            <div class="row">
                <div class="col-md-12">
                    <div class="portlet box blue-hoki">
                        <div class="portlet-title">
                            <div class="caption">
                                Formulario a llenar
                            </div>
                            <div class="tools">
                                <a href="" class="fullscreen"> </a>
                            </div>
                        </div>
                        <div class="portlet-body form">
                            <!-- BEGIN FORM-->
                            <form asp-action="ModificarParametro" asp-controller="ctParametro" id="modificarParametro">
                                <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                                <div class="form-body">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" asp-for="IdParametro" />
                                    <div class="form-group">
                                        <label class="control-label">Nombre <span class="required"> (*) </span></label>
                                        <input asp-for="Nombre" type="text" class="form-control" placeholder="Nombre del par&aacute;metro" autocomplete="off">
                                        <span asp-validation-for="Nombre" class="required"></span>
                                    </div>
                                    <div class="form-group">
                                        <label class="control-label">Valor</label>
                                        <input asp-for="Valor" type="text" class="form-control" placeholder="Valor del par&aacute;metro" autocomplete="off">
                                        <span asp-validation-for="Valor" class="required"></span>
                                    </div>
                                    <div class="form-group">
                                        <label>Grupo <span class="required"> (*) </span></label>
                                        <input type="text" asp-for="Grupo" class="form-control" placeholder="Grupo al que pertenece" autocomplete="off">
                                        <span asp-validation-for="Grupo" class="required"></span>
                                    </div>
                                </div>
                                <div class="form-actions">
                                    <div class="btn-set pull-left">
                                        <a asp-action="Parametros" asp-controller="ctParametro" class="btn blue-hoki btn-outline sbold uppercase"><i class="fa fa-close"></i> Cancelar</a>
                                    </div>
                                    <div class="btn-set pull-right">
                                        <button type="submit" class="btn blue-hoki btn-outline sbold uppercase"><i class="fa fa-check"></i> Guardar cambios</button>
                                    </div>
                                </div>
                            </form>
                            <!-- END FORM-->
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <!-- END PAGE CONTENT INNER -->
    </div>
</div>
<!-- END PAGE CONTENT BODY -->
@section Scripts{
<script type="text/javascript">
    var siSatisfactorio = '@respuesta.SiSatisfactorio';
    var mensaje = '@respuesta.Mensaje';

    if (siSatisfactorio == "True") {
        toastr["success"](mensaje, "Registro exitoso");
    } else if (mensaje != "" && mensaje != null) {
        toastr["error"](mensaje, "Operación fallida");
    }
</script>

<script type="text/javascript" src="~/global/scripts/toastr.js"></script>
}