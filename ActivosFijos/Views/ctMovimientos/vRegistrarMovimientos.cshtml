@using ActivosFijos.Clases
@using System.Globalization
@{
    ViewData["Title"] = "Registrar Movimientos";
    Layout = "~/Views/Shared/_Layout.cshtml";

    ViewBag.tituloDelContenido = ViewData["Title"];
    ViewBag.subTituloDelContenido = "Pantalla para declarar los movimientos de los Activos Fijos antes de importar el submayor";

    clResponse<ActivosFijos.Models.EntidadesBD.TrasladosAft> respuesta = new clResponse<ActivosFijos.Models.EntidadesBD.TrasladosAft>();
    if (ViewBag.respuesta != null)
    {
        respuesta = ViewBag.respuesta;
    }

    string periodo = Model.Fecha.ToString("MM/yyyy", CultureInfo.InvariantCulture);
    string seleccionado = Model.Formulario.Id == Guid.Empty ? "nuevo" : "editar";
}

@model ActivosFijos.Models.Auxiliar.mdMovimientos

@section PluginsCSS{
    <environment names="Development,Staging,Production">
        <link href="~/global/plugins/eonasdan-bootstrap-datetimepicker/build/css/bootstrap-datetimepicker.min.css" rel="stylesheet" type="text/css" />
        <link href="~/global/plugins/select2/css/select2.min.css" rel="stylesheet" type="text/css" />
        <link href="~/global/plugins/select2/css/select2-bootstrap.min.css" rel="stylesheet" type="text/css" />
    </environment>
}
<div class="page-head">
    <div class="container-fluid">
        <!-- BEGIN PAGE TITLE -->
        <div class="page-title">
            <h1>
                Activos Fijos | Declarar Movimientos
            </h1>
        </div>
        <!-- END PAGE TITLE -->
    </div>
</div>

<!-- BEGIN PAGE CONTENT BODY -->
<div class="page-content">
    <div class="container-fluid">
        <!-- BEGIN PAGE BREADCRUMBS -->
        <ul class="page-breadcrumb breadcrumb">
            <li>
                <a asp-action="Inicio" asp-controller="ctInicio">Inicio</a>
                <i class="fa fa-circle"></i>
            </li>
            <li>
                <a asp-action="DetallesDeMovimientos" asp-controller="ctActFijos">Movimientos Mensuales</a>
                <i class="fa fa-circle"></i>
            </li>
            <li>
                <span>Declarar Movimientos</span>
            </li>
        </ul>
        <!-- END PAGE BREADCRUMBS -->
        <!-- BEGIN PAGE CONTENT INNER -->
        <div class="page-content-inner">
            <div class="row">
                <div class="col-md-12">
                    <div class="portlet box blue-hoki">
                        <div class="portlet-title">
                            <div class="caption">
                                Periodo de trabajo
                            </div>
                            <div class="tools">
                                <a href="" class="fullscreen"> </a>
                            </div>
                        </div>
                        <div class="portlet-body">
                            <div class="form-group">
                                <label class="control-label">Ãšltimo submayor importado:</label>
                                <span class="form-control-static" style="display:inline-block;margin-left:5px">@periodo</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="row">
                <div class="col-md-4">
                    <div class="portlet box blue-hoki">
                        <div class="portlet-title">
                            <div class="caption">
                                @(seleccionado == "nuevo" ? "Nuevo movimiento" : "Editar movimiento")
                            </div>
                            <div class="tools">
                                <a href="" class="fullscreen"> </a>
                            </div>
                        </div>
                        <div class="portlet-body form">
                            <form asp-action="GuardarMovimiento" asp-controller="ctMovimientos" method="post">
                                <div class="form-body">
                                    @Html.AntiForgeryToken()
                                    @Html.ValidationSummary(true, "", new { @class = "text-danger" })
                                    <input type="hidden" name="fecha" value="@periodo" />
                                    <input type="hidden" name="Id" value="@Model.Formulario.Id" />

                                    <div class="form-group">
                                        <label class="control-label">No. Inventario <span class="required"> (*) </span></label>
                                        <div class="row">
                                            <div class="col-xs-8">
                                                <input type="text" name="NoInventario" id="NoInventario" class="form-control"
                                                       value="@(Model.Formulario.NoInventario == 0 ? "" : Model.Formulario.NoInventario.ToString())"
                                                       placeholder="No. de Inventario" autocomplete="off" />
                                            </div>
                                            <div class="col-xs-4">
                                                <input type="text" name="SubNumero" id="SubNumero" class="form-control"
                                                       value="@Model.Formulario.SubNumero" placeholder="Sub." autocomplete="off" />
                                            </div>
                                        </div>
                                        @Html.ValidationMessage("NoInventario", "", new { @class = "text-danger" })
                                        @Html.ValidationMessage("SubNumero", "", new { @class = "text-danger" })
                                    </div>

                                    <div class="form-group">
                                        <label class="control-label">Tipo de movimiento <span class="required"> (*) </span></label>
                                        <select name="TipoMovimiento" id="TipoMovimiento" class="form-control">
                                            <option value="">-- Seleccione --</option>
                                            @foreach (var tipo in Model.Tipos)
                                            {
                                                <option value="@tipo.IdTipoMovimientoAFT" selected="@(Model.Formulario.TipoMovimiento == tipo.IdTipoMovimientoAFT ? "selected" : null)">@tipo.Nombre</option>
                                            }
                                        </select>
                                        @Html.ValidationMessage("TipoMovimiento", "", new { @class = "text-danger" })
                                    </div>

                                    <div class="form-group">
                                        <label class="control-label">Responsable de destino <span class="required"> (*) </span></label>
                                        <select name="Responsable" id="Responsable" class="form-control">
                                            <option value="">-- Seleccione --</option>
                                            @foreach (var responsable in Model.Responsables)
                                            {
                                                string nombreCompleto = ((responsable.Nombre ?? "") + " " + (responsable.Apellidos ?? "")).Trim();
                                                <option value="@responsable.IdResponsable"
                                                        data-area="@(responsable.AreaResponsabilidadNavigation == null ? "" : responsable.AreaResponsabilidadNavigation.Nombre)"
                                                        selected="@(Model.Formulario.Responsable == responsable.IdResponsable ? "selected" : null)">@nombreCompleto</option>
                                            }
                                        </select>
                                        @Html.ValidationMessage("Responsable", "", new { @class = "text-danger" })
                                    </div>

                                    <div class="form-group">
                                        <label class="control-label">&Aacute;rea de destino</label>
                                        <input type="text" id="AreaDestino" class="form-control" value="" readonly="readonly" />
                                    </div>

                                    <div class="form-group">
                                        <label class="control-label">Desde <span class="required"> (*) </span></label>
                                        <input type="date" name="desde" id="desde" class="form-control"
                                               value="@(Model.Formulario.Desde > DateTime.MinValue ? Model.Formulario.Desde.ToString("yyyy-MM-dd") : "")" />
                                        @Html.ValidationMessage("Desde", "", new { @class = "text-danger" })
                                    </div>

                                    <div class="form-group">
                                        <label class="control-label">Hasta (opcional)</label>
                                        <input type="date" name="hasta" id="hasta" class="form-control"
                                               value="@(Model.Formulario.Hasta == null ? "" : Model.Formulario.Hasta.Value.ToString("yyyy-MM-dd"))" />
                                        @Html.ValidationMessage("Hasta", "", new { @class = "text-danger" })
                                    </div>

                                    <div class="form-group">
                                        <label class="control-label">Motivo</label>
                                        <textarea name="Motivo" id="Motivo" class="form-control" rows="3" placeholder="Motivo del movimiento">@Model.Formulario.Motivo</textarea>
                                        @Html.ValidationMessage("Motivo", "", new { @class = "text-danger" })
                                    </div>
                                </div>
                                <div class="form-actions">
                                    <div class="btn-set pull-left">
                                        <a asp-action="RegistrarMovimientos" asp-controller="ctMovimientos" asp-route-fecha="@periodo" class="btn blue-hoki btn-outline sbold uppercase"><i class="fa fa-close"></i> @(seleccionado == "nuevo" ? "Limpiar" : "Cancelar edici\u00f3n")</a>
                                    </div>
                                    <div class="btn-set pull-right">
                                        <button type="submit" class="btn blue-hoki btn-outline sbold uppercase"><i class="fa fa-check"></i> Guardar cambios</button>
                                    </div>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>

                <div class="col-md-8">
                    <div class="portlet box blue-hoki">
                        <div class="portlet-title">
                            <div class="caption">
                                Movimientos declarados en @periodo
                            </div>
                            <div class="tools">
                                <a href="" class="fullscreen"> </a>
                            </div>
                        </div>
                        <div class="portlet-body">
                            <table class="table table-striped table-bordered table-hover" id="tablaMovimientos">
                                <thead style="background-color: #444d58 !important; color: #ced5de">
                                    <tr>
                                        <th scope="col" style="text-align:center">No. Inv.</th>
                                        <th scope="col" style="text-align:center">Sub.</th>
                                        <th scope="col" style="text-align:justify">Tipo de movimiento</th>
                                        <th scope="col" style="text-align:justify">Responsable de destino</th>
                                        <th scope="col" style="text-align:justify">&Aacute;rea de destino</th>
                                        <th scope="col" style="text-align:center">Desde</th>
                                        <th scope="col" style="text-align:center">Hasta</th>
                                        <th scope="col" style="text-align:justify">Motivo</th>
                                        <th scope="col" style="text-align:center" width="150px">Acciones</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @if (Model.Movimientos.Count == 0)
                                    {
                                        <tr>
                                            <td colspan="9" style="text-align:center">
                                                No hay movimientos declarados en este periodo.
                                            </td>
                                        </tr>
                                    }
                                    else
                                    {
                                        foreach (var item in Model.Movimientos)
                                        {
                                            <tr>
                                                <td style="text-align:center">@item.NoInventario</td>
                                                <td style="text-align:center">@item.SubNumero</td>
                                                <td style="text-align:justify">@(item.TipoMovimientoNavigation == null ? "" : item.TipoMovimientoNavigation.Nombre)</td>
                                                <td style="text-align:justify">@(item.ResponsableNavigation == null ? "" : ((item.ResponsableNavigation.Nombre ?? "") + " " + (item.ResponsableNavigation.Apellidos ?? "")).Trim())</td>
                                                <td style="text-align:justify">@(item.AreaDestinoNavigation == null ? "" : item.AreaDestinoNavigation.Nombre)</td>
                                                <td style="text-align:center">@item.Desde.ToString("dd/MM/yyyy")</td>
                                                <td style="text-align:center">@(item.Hasta == null ? "Vigente" : item.Hasta.Value.ToString("dd/MM/yyyy"))</td>
                                                <td style="text-align:justify">@item.Motivo</td>
                                                <td style="text-align:center">
                                                    <a asp-action="RegistrarMovimientos" asp-controller="ctMovimientos" asp-route-id="@item.Id" asp-route-fecha="@periodo" class="btn btn-xs default" title="Editar">
                                                        <i class="fa fa-pencil"></i>
                                                    </a>
                                                    <form asp-action="EliminarMovimiento" asp-controller="ctMovimientos" method="post" style="display:inline">
                                                        @Html.AntiForgeryToken()
                                                        <input type="hidden" name="id" value="@item.Id" />
                                                        <input type="hidden" name="fecha" value="@periodo" />
                                                        <button type="submit" class="btn btn-xs default" title="Eliminar" onclick="return confirm('&#191;Est&#225; seguro de que desea eliminar este movimiento?');">
                                                            <i class="fa fa-trash"></i>
                                                        </button>
                                                    </form>
                                                </td>
                                            </tr>
                                        }
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <!-- END PAGE CONTENT INNER -->
    </div>
</div>
<!-- END PAGE CONTENT BODY -->

@section PluginsJS {
    <environment names="Development,Staging,Production">
        <script src="~/global/plugins/notifications/noty.min.js"></script>
        <script type="text/javascript" src="~/global/plugins/moment/min/moment.min.js"></script>
        <script type="text/javascript" src="~/global/plugins/moment/locale/es.js"></script>
        <script src="~/global/plugins/eonasdan-bootstrap-datetimepicker/build/js/bootstrap-datetimepicker.min.js" type="text/javascript"></script>
        <script src="~/global/plugins/select2/js/select2.full.min.js" type="text/javascript"></script>
    </environment>
}

@section Scripts {
    <script type="text/javascript">
        var baseUrl = $('base').attr('href');

        var siSatisfactorio = '@respuesta.SiSatisfactorio';
        var mensaje = '@respuesta.Mensaje';

        if ((siSatisfactorio == "True") && (mensaje != "")) {
            MiApp.Mensajes.mostrarNotificacion("success", mensaje);
        }
        else if (mensaje != "" && mensaje != null) {
            MiApp.Mensajes.mostrarNotificacion("error", mensaje);
        }


        $.fn.select2.defaults.set("theme", "bootstrap");
        $('#Responsable').select2({
            placeholder: "Seleccione el responsable",
            width: null
        });

        function PintarAreaDeDestino() {
            var area = $('#Responsable').find('option:selected').data('area');
            $('#AreaDestino').val(area || '');
        }

        $('#Responsable').on('change', PintarAreaDeDestino);
        PintarAreaDeDestino();
    </script>
}
